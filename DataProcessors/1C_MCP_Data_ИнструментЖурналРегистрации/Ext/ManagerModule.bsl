// Инструмент MCP: чтение журнала регистрации.
//
// Агент получает события журнала регистрации с отборами по периоду, уровню,
// событию, пользователю, компьютеру и объектам метаданных. По умолчанию
// возвращаются последние события: окно периода расширяется автоматически,
// пока не наберётся запрошенное количество или не будет прочитан весь журнал.
//
// Требуется право "ЖурналРегистрации" (EventLog) в основной конфигурации:
// роли расширения не могут предоставить это право основной конфигурации.

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Добавляет инструменты обработки-контейнера в таблицу инструментов сервера MCP.
//
// Общие модули расширения MCP_Сервер недоступны из этого расширения, поэтому
// строка инструмента и JSON-схема параметров строятся локально по контракту
// mcp_Метаданные.ДобавитьИнструмент и mcp_Метаданные.СхемаПараметровИнструмента.
//
// Параметры:
//  Инструменты - ТаблицаЗначений - таблица инструментов сервера MCP с колонками
//                ИмяОбработкиКонтейнера, Имя, Описание, СхемаПараметров.
//
Процедура ДобавитьИнструменты(Инструменты) Экспорт

	МассивПараметров = Новый Массив;

	МассивПараметров.Добавить(ОписаниеПараметра(
		"dateFrom",
		"string",
		"Начало периода в локальном времени сервера: ГГГГ-ММ-ДД или ГГГГ-ММ-ДДTЧЧ:ММ:СС. Если не указано, читаются последние события (окно расширяется автоматически)."
	));

	МассивПараметров.Добавить(ОписаниеПараметра(
		"dateTo",
		"string",
		"Окончание периода в локальном времени сервера. Если указана только дата, включается весь день. По умолчанию — текущий момент."
	));

	МассивПараметров.Добавить(ОписаниеПараметра(
		"errorsOnly",
		"boolean",
		"Только ошибки (эквивалентно levels = [""Ошибка""]).",
		Ложь
	));

	МассивПараметров.Добавить(ОписаниеПараметраМассив(
		"levels",
		"string",
		"Уровни событий. Допустимые значения: Информация, Предупреждение, Ошибка, Примечание.",
		"Информация,Предупреждение,Ошибка,Примечание"
	));

	МассивПараметров.Добавить(ОписаниеПараметраМассив(
		"events",
		"string",
		"Имена событий журнала, например _$PerformError$_, _$Session$_.Start."
	));

	МассивПараметров.Добавить(ОписаниеПараметраМассив(
		"users",
		"string",
		"Имена пользователей информационной базы."
	));

	МассивПараметров.Добавить(ОписаниеПараметраМассив(
		"computers",
		"string",
		"Имена компьютеров."
	));

	МассивПараметров.Добавить(ОписаниеПараметраМассив(
		"metadata",
		"string",
		"Полные имена объектов метаданных, например Документ.РеализацияТоваровУслуг."
	));

	МассивПараметров.Добавить(ОписаниеПараметра(
		"comment",
		"string",
		"Точный текст комментария события."
	));

	МассивПараметров.Добавить(ОписаниеПараметра(
		"limit",
		"number",
		"Максимальное количество событий (1–1000).",
		100
	));

	МассивПараметров.Добавить(ОписаниеПараметра(
		"order",
		"string",
		"Порядок вывода: desc — от новых к старым, asc — от старых к новым.",
		"desc",
		Ложь,
		"desc,asc"
	));

	СтрокаИнструмента = Инструменты.Добавить();
	СтрокаИнструмента.Имя = "read_event_log";
	СтрокаИнструмента.Описание = "Чтение журнала регистрации 1С: последние события, только ошибки, период, события, пользователи, компьютеры и объекты метаданных. Требуется право ""Журнал регистрации"" (EventLog).";
	СтрокаИнструмента.СхемаПараметров = СхемаПараметровИнструмента(МассивПараметров);

КонецПроцедуры

// Выполняет инструмент сервера MCP по имени.
//
// Параметры:
//  ИмяИнструмента - Строка - имя инструмента, объявленного в ДобавитьИнструменты.
//  Аргументы - Структура - аргументы вызова инструмента.
//
// Возвращаемое значение:
//  Строка - текстовый результат выполнения инструмента.
//
Функция ВыполнитьИнструмент(ИмяИнструмента, Аргументы) Экспорт

	Если ИмяИнструмента = "read_event_log" Тогда
		Возврат ПрочитатьЖурналРегистрации(Аргументы);
	КонецЕсли;

	ВызватьИсключение "Неизвестный инструмент: " + ИмяИнструмента;

КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Читает журнал регистрации по аргументам инструмента и формирует текст результата.
//
// Параметры:
//  Аргументы - Структура - аргументы вызова инструмента, см. ДобавитьИнструменты.
//
// Возвращаемое значение:
//  Строка - заголовок, формат и события журнала построчно.
//
Функция ПрочитатьЖурналРегистрации(Аргументы)

	Если НЕ ПравоДоступа("ЖурналРегистрации", Метаданные) Тогда
		ВызватьИсключение "Недостаточно прав для чтения журнала регистрации. Требуется право ""Журнал регистрации"" (EventLog) в основной конфигурации.";
	КонецЕсли;

	Лимит = ЛимитИзАргументов(Аргументы);

	Порядок = "desc";
	Если Аргументы.Свойство("order") И НРег(Строка(Аргументы.order)) = "asc" Тогда
		Порядок = "asc";
	КонецЕсли;

	ЕстьДатаНачала = Аргументы.Свойство("dateFrom") И ЗначениеЗаполнено(Аргументы.dateFrom);
	ЕстьДатаОкончания = Аргументы.Свойство("dateTo") И ЗначениеЗаполнено(Аргументы.dateTo);

	Если ЕстьДатаОкончания Тогда
		ДатаОкончания = ДатаПериодаИзСтроки(Аргументы.dateTo, Истина);
	Иначе
		ДатаОкончания = ТекущаяДатаСеанса();
	КонецЕсли;

	ОтборДоп = ОтборДополнительныхУсловий(Аргументы);

	Если ЕстьДатаНачала Тогда
		ДатаНачала = ДатаПериодаИзСтроки(Аргументы.dateFrom, Ложь);
		Если ДатаНачала > ДатаОкончания Тогда
			ВызватьИсключение "Дата начала периода больше даты окончания.";
		КонецЕсли;
		Таблица = ПрочитатьПорцию(ДатаНачала, ДатаОкончания, Лимит, ОтборДоп);
	ИначеЕсли ЕстьДатаОкончания Тогда
		ДатаНачала = ДатаОкончания - 24 * 60 * 60;
		Таблица = ПрочитатьПорцию(ДатаНачала, ДатаОкончания, Лимит, ОтборДоп);
	Иначе
		Результат = ПрочитатьПоследние(ДатаОкончания, Лимит, ОтборДоп);
		Таблица = Результат.Таблица;
		ДатаНачала = Результат.ДатаНачала;
	КонецЕсли;

	Возврат СформироватьТекст(Таблица, ДатаНачала, ДатаОкончания, Порядок);

КонецФункции

// Читает последние события, расширяя окно периода до набора лимита или до начала журнала.
//
// Параметры:
//  ДатаОкончания - Дата - правый край окна чтения.
//  Лимит - Число - максимальное количество событий.
//  ОтборДоп - Структура - дополнительные условия отбора.
//
// Возвращаемое значение:
//  Структура - поля Таблица (ТаблицаЗначений) и ДатаНачала (Дата, Неопределено).
//
Функция ПрочитатьПоследние(ДатаОкончания, Лимит, ОтборДоп)

	МассивОкон = Новый Массив;
	МассивОкон.Добавить(24 * 60 * 60);
	МассивОкон.Добавить(7 * 24 * 60 * 60);
	МассивОкон.Добавить(30 * 24 * 60 * 60);
	МассивОкон.Добавить(365 * 24 * 60 * 60);
	МассивОкон.Добавить(0);

	Таблица = Неопределено;
	ДатаНачала = Неопределено;

	Для Каждого Окно Из МассивОкон Цикл
		Если Окно = 0 Тогда
			ДатаНачала = Неопределено;
		Иначе
			ДатаНачала = ДатаОкончания - Окно;
		КонецЕсли;

		Таблица = ПрочитатьПорцию(ДатаНачала, ДатаОкончания, Лимит, ОтборДоп);

		Если Таблица.Количество() >= Лимит Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат Новый Структура("Таблица,ДатаНачала", Таблица, ДатаНачала);

КонецФункции

// Читает порцию журнала регистрации за указанный период.
//
// Параметры:
//  ДатаНачала - Дата, Неопределено - начало периода; Неопределено — без ограничения.
//  ДатаОкончания - Дата - окончание периода.
//  Лимит - Число - максимальное количество событий.
//  ОтборДоп - Структура - дополнительные условия отбора.
//
// Возвращаемое значение:
//  ТаблицаЗначений - события журнала.
//
Функция ПрочитатьПорцию(ДатаНачала, ДатаОкончания, Лимит, ОтборДоп)

	Отбор = Новый Структура;
	Для Каждого ЭлементОтбора Из ОтборДоп Цикл
		Отбор.Вставить(ЭлементОтбора.Ключ, ЭлементОтбора.Значение);
	КонецЦикла;

	Смещение = СмещениеВремениСервера();

	Если ДатаНачала <> Неопределено Тогда
		Отбор.Вставить("ДатаНачала", ДатаНачала + Смещение);
	КонецЕсли;
	Отбор.Вставить("ДатаОкончания", ДатаОкончания + Смещение);

	Таблица = Новый ТаблицаЗначений;
	ВыгрузитьЖурналРегистрации(Таблица, Отбор, КолонкиЖурналаРегистрации(), , Лимит);

	Возврат Таблица;

КонецФункции

// Формирует дополнительные условия отбора журнала регистрации по аргументам инструмента.
//
// Параметры:
//  Аргументы - Структура - аргументы вызова инструмента.
//
// Возвращаемое значение:
//  Структура - условия отбора журнала регистрации.
//
Функция ОтборДополнительныхУсловий(Аргументы)

	Отбор = Новый Структура;

	Если Аргументы.Свойство("errorsOnly") И ТипЗнч(Аргументы.errorsOnly) = Тип("Булево") И Аргументы.errorsOnly Тогда
		Отбор.Вставить("Уровень", УровеньЖурналаРегистрации.Ошибка);
	ИначеЕсли Аргументы.Свойство("levels") И ТипЗнч(Аргументы.levels) = Тип("Массив") И Аргументы.levels.Количество() > 0 Тогда
		МассивУровней = Новый Массив;
		Для Каждого Значение Из Аргументы.levels Цикл
			МассивУровней.Добавить(УровеньПоИмени(Значение));
		КонецЦикла;
		Если МассивУровней.Количество() = 1 Тогда
			Отбор.Вставить("Уровень", МассивУровней[0]);
		Иначе
			Отбор.Вставить("Уровень", МассивУровней);
		КонецЕсли;
	КонецЕсли;

	ДобавитьСтроковыйОтбор(Отбор, "Событие", Аргументы, "events");
	ДобавитьСтроковыйОтбор(Отбор, "Пользователь", Аргументы, "users");
	ДобавитьСтроковыйОтбор(Отбор, "Компьютер", Аргументы, "computers");

	Если Аргументы.Свойство("metadata") И ТипЗнч(Аргументы.metadata) = Тип("Массив") И Аргументы.metadata.Количество() > 0 Тогда
		МассивМетаданных = Новый Массив;
		Для Каждого ПолноеИмя Из Аргументы.metadata Цикл
			ИмяМетаданного = СокрЛП(Строка(ПолноеИмя));
			Если ПустаяСтрока(ИмяМетаданного) Тогда
				Продолжить;
			КонецЕсли;
			МетаданныеОбъекта = Метаданные.НайтиПоПолномуИмени(ИмяМетаданного);
			Если МетаданныеОбъекта = Неопределено Тогда
				ВызватьИсключение "Объект метаданных не найден: " + ИмяМетаданного;
			КонецЕсли;
			МассивМетаданных.Добавить(МетаданныеОбъекта);
		КонецЦикла;
		Если МассивМетаданных.Количество() = 1 Тогда
			Отбор.Вставить("Метаданные", МассивМетаданных[0]);
		ИначеЕсли МассивМетаданных.Количество() > 1 Тогда
			Отбор.Вставить("Метаданные", МассивМетаданных);
		КонецЕсли;
	КонецЕсли;

	Если Аргументы.Свойство("comment") И ЗначениеЗаполнено(Аргументы.comment) Тогда
		Отбор.Вставить("Комментарий", Строка(Аргументы.comment));
	КонецЕсли;

	Возврат Отбор;

КонецФункции

// Добавляет в отбор журнала строковое условие по аргументу инструмента.
//
// Параметры:
//  Отбор - Структура - условия отбора журнала регистрации.
//  ИмяПоля - Строка - имя поля отбора журнала регистрации.
//  Аргументы - Структура - аргументы вызова инструмента.
//  ИмяАргумента - Строка - имя аргумента инструмента.
//
Процедура ДобавитьСтроковыйОтбор(Отбор, ИмяПоля, Аргументы, ИмяАргумента)

	Если НЕ Аргументы.Свойство(ИмяАргумента) Тогда
		Возврат;
	КонецЕсли;

	Значение = Аргументы[ИмяАргумента];

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Массив = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Если ЗначениеЗаполнено(Элемент) Тогда
				Массив.Добавить(Строка(Элемент));
			КонецЕсли;
		КонецЦикла;
		Если Массив.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		Если Массив.Количество() = 1 Тогда
			Отбор.Вставить(ИмяПоля, Массив[0]);
		Иначе
			Отбор.Вставить(ИмяПоля, Массив);
		КонецЕсли;
	ИначеЕсли ЗначениеЗаполнено(Значение) Тогда
		Отбор.Вставить(ИмяПоля, Строка(Значение));
	КонецЕсли;

КонецПроцедуры

// Преобразует имя уровня события в значение перечисления.
//
// Параметры:
//  Значение - Произвольный - имя уровня на русском или английском языке.
//
// Возвращаемое значение:
//  УровеньЖурналаРегистрации - уровень события журнала регистрации.
//
Функция УровеньПоИмени(Значение)

	Имя = НРег(СокрЛП(Строка(Значение)));

	Если Имя = "ошибка" ИЛИ Имя = "error" Тогда
		Возврат УровеньЖурналаРегистрации.Ошибка;
	ИначеЕсли Имя = "предупреждение" ИЛИ Имя = "warning" ИЛИ Имя = "warn" Тогда
		Возврат УровеньЖурналаРегистрации.Предупреждение;
	ИначеЕсли Имя = "информация" ИЛИ Имя = "information" ИЛИ Имя = "info" Тогда
		Возврат УровеньЖурналаРегистрации.Информация;
	ИначеЕсли Имя = "примечание" ИЛИ Имя = "note" Тогда
		Возврат УровеньЖурналаРегистрации.Примечание;
	КонецЕсли;

	ВызватьИсключение "Недопустимый уровень события: " + Строка(Значение)
		+ ". Допустимые значения: Информация, Предупреждение, Ошибка, Примечание.";

КонецФункции

// Возвращает количество событий из аргументов инструмента в допустимом диапазоне.
//
// Параметры:
//  Аргументы - Структура - аргументы вызова инструмента.
//
// Возвращаемое значение:
//  Число - количество событий от 1 до 1000.
//
Функция ЛимитИзАргументов(Аргументы)

	Лимит = 100;

	Если Аргументы.Свойство("limit") И ЗначениеЗаполнено(Аргументы.limit) Тогда
		Лимит = Цел(Аргументы.limit);
	КонецЕсли;

	Если Лимит < 1 Тогда
		Лимит = 1;
	ИначеЕсли Лимит > 1000 Тогда
		Лимит = 1000;
	КонецЕсли;

	Возврат Лимит;

КонецФункции

// Формирует текст результата: заголовок с периодом и строки событий.
//
// Параметры:
//  Таблица - ТаблицаЗначений - события журнала.
//  ДатаНачала - Дата, Неопределено - начало прочитанного периода.
//  ДатаОкончания - Дата - окончание прочитанного периода.
//  Порядок - Строка - desc или asc.
//
// Возвращаемое значение:
//  Строка - текст результата.
//
Функция СформироватьТекст(Таблица, ДатаНачала, ДатаОкончания, Порядок)

	Если Порядок = "desc" Тогда
		Таблица.Сортировать("Дата Убыв");
	Иначе
		Таблица.Сортировать("Дата Возр");
	КонецЕсли;

	Смещение = СмещениеВремениСервера();

	Если ДатаНачала = Неопределено Тогда
		ТекстПериода = "за весь журнал";
	Иначе
		ТекстПериода = "за период " + ФорматДаты(ДатаНачала) + " - " + ФорматДаты(ДатаОкончания);
	КонецЕсли;

	Строки = Новый Массив;
	Строки.Добавить("Журнал регистрации. Событий: " + Таблица.Количество() + ". " + ТекстПериода + ".");

	Если Таблица.Количество() > 0 Тогда
		Строки.Добавить("Формат: дата | уровень | событие | пользователь | компьютер | метаданные | данные | комментарий | транзакция");

		Для Каждого СтрокаСобытия Из Таблица Цикл
			Событие = ПолеВывода(СтрокаСобытия.Событие, 100);

			Если ЗначениеЗаполнено(СтрокаСобытия.ПредставлениеСобытия) Тогда
				ПредставлениеСобытия = ПолеВывода(СтрокаСобытия.ПредставлениеСобытия, 100);
				Если ПредставлениеСобытия <> "-" И ПредставлениеСобытия <> Событие Тогда
					Событие = Событие + " (" + ПредставлениеСобытия + ")";
				КонецЕсли;
			КонецЕсли;

			Строки.Добавить(
				ФорматДаты(СтрокаСобытия.Дата - Смещение)
				+ " | " + Строка(СтрокаСобытия.Уровень)
				+ " | " + Событие
				+ " | " + ПолеВывода(СтрокаСобытия.ИмяПользователя, 100)
				+ " | " + ПолеВывода(СтрокаСобытия.Компьютер, 100)
				+ " | " + ПолеВывода(МетаданныеВСтроку(СтрокаСобытия.Метаданные), 300)
				+ " | " + ПолеВывода(СтрокаСобытия.ПредставлениеДанных, 300)
				+ " | " + ПолеВывода(СтрокаСобытия.Комментарий, 300)
				+ " | " + ПолеВывода(ПредставлениеСтатусаТранзакции(СтрокаСобытия.СтатусТранзакции), 50)
			);
		КонецЦикла;
	КонецЕсли;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Возвращает список колонок журнала регистрации для выгрузки.
//
// Возвращаемое значение:
//  Строка - имена колонок через запятую.
//
Функция КолонкиЖурналаРегистрации()

	Возврат "Дата,Уровень,Событие,ПредставлениеСобытия,ИмяПользователя,Компьютер,Метаданные,ПредставлениеДанных,Комментарий,СтатусТранзакции";

КонецФункции

// Разбирает дату периода из строки в формате ГГГГ-ММ-ДД или ГГГГ-ММ-ДДTЧЧ:ММ:СС.
//
// Параметры:
//  Значение - Дата, Строка - дата периода.
//  КонецПериода - Булево - Истина, если для даты без времени нужно окончание дня.
//
// Возвращаемое значение:
//  Дата - разобранная дата.
//
Функция ДатаПериодаИзСтроки(Значение, КонецПериода)

	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Значение;
	КонецЕсли;

	ТекстДаты = СокрЛП(Строка(Значение));
	ДатаРезультат = Неопределено;

	Попытка
		ДатаРезультат = ПрочитатьДатуJSON(ТекстДаты, ФорматДатыJSON.ISO);
	Исключение
		ДатаРезультат = Неопределено;
	КонецПопытки;

	Если ДатаРезультат = Неопределено Тогда
		Части = СтрРазделить(ТекстДаты, "-", Ложь);
		Если Части.Количество() = 3 Тогда
			Попытка
				ДатаРезультат = Дата(Число(Части[0]), Число(Части[1]), Число(Части[2]));
			Исключение
				ДатаРезультат = Неопределено;
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;

	Если ДатаРезультат = Неопределено Тогда
		ВызватьИсключение "Некорректная дата: " + ТекстДаты + ". Ожидается ГГГГ-ММ-ДД или ГГГГ-ММ-ДДTЧЧ:ММ:СС.";
	КонецЕсли;

	Если СтрНайти(ТекстДаты, ":") = 0 Тогда
		Если КонецПериода Тогда
			ДатаРезультат = Дата(Год(ДатаРезультат), Месяц(ДатаРезультат), День(ДатаРезультат), 23, 59, 59);
		Иначе
			ДатаРезультат = Дата(Год(ДатаРезультат), Месяц(ДатаРезультат), День(ДатаРезультат), 0, 0, 0);
		КонецЕсли;
	КонецЕсли;

	Возврат ДатаРезультат;

КонецФункции

// Возвращает смещение времени сервера относительно времени сеанса.
//
// Журнал регистрации хранит даты в часовом поясе сервера, а аргументы инструмента
// и вывод — в часовом поясе сеанса.
//
// Возвращаемое значение:
//  Число - смещение в секундах.
//
Функция СмещениеВремениСервера()

	Смещение = ТекущаяДата() - ТекущаяДатаСеанса();
	Если Смещение >= -1 И Смещение <= 1 Тогда
		Смещение = 0;
	КонецЕсли;

	Возврат Смещение;

КонецФункции

// Преобразует значение колонки "Метаданные" в строку.
//
// Параметры:
//  Значение - Произвольный - значение колонки.
//
// Возвращаемое значение:
//  Строка - имена объектов метаданных через запятую.
//
Функция МетаданныеВСтроку(Значение)

	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Части = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Если ЗначениеЗаполнено(Элемент) Тогда
				Части.Добавить(Строка(Элемент));
			КонецЕсли;
		КонецЦикла;
		Возврат СтрСоединить(Части, ", ");
	КонецЕсли;

	Возврат Строка(Значение);

КонецФункции

// Возвращает представление статуса транзакции записи журнала регистрации.
//
// Параметры:
//  Статус - СтатусТранзакцииЗаписиЖурналаРегистрации, Неопределено - статус транзакции.
//
// Возвращаемое значение:
//  Строка - пустая строка для зафиксированной транзакции, иначе представление статуса.
//
Функция ПредставлениеСтатусаТранзакции(Статус)

	Если Статус = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Если Статус = СтатусТранзакцииЗаписиЖурналаРегистрации.Зафиксирована Тогда
		Возврат "";
	КонецЕсли;

	Возврат Строка(Статус);

КонецФункции

// Преобразует значение ячейки в однострочный текст с ограничением длины.
//
// Параметры:
//  Значение - Произвольный - значение ячейки.
//  МаксДлина - Число - максимальная длина текста.
//
// Возвращаемое значение:
//  Строка - однострочный текст; "-" для пустого значения.
//
Функция ПолеВывода(Значение, МаксДлина = 300)

	Если Значение = Неопределено Тогда
		Возврат "-";
	КонецЕсли;

	Текст = Строка(Значение);

	Если ПустаяСтрока(Текст) Тогда
		Возврат "-";
	КонецЕсли;

	Текст = СтрЗаменить(Текст, Символы.ПС, " ");
	Текст = СтрЗаменить(Текст, Символы.ВК, " ");
	Текст = СтрЗаменить(Текст, "|", "/");

	Если СтрДлина(Текст) > МаксДлина Тогда
		Текст = Лев(Текст, МаксДлина) + "...";
	КонецЕсли;

	Возврат Текст;

КонецФункции

// Форматирует дату для вывода в тексте результата.
//
// Параметры:
//  Дата - Дата - дата события или граница периода.
//
// Возвращаемое значение:
//  Строка - дата в формате ГГГГ-ММ-ДД ЧЧ:ММ:СС.
//
Функция ФорматДаты(Дата)

	Возврат Формат(Дата, "ДФ='yyyy-MM-dd HH:mm:ss'");

КонецФункции

// Создаёт описание простого параметра инструмента для построения JSON-схемы.
//
// Параметры:
//  Имя - Строка - имя параметра.
//  Тип - Строка - тип параметра в терминах JSON Schema, например "string".
//  Описание - Строка - описание параметра для ассистента.
//  ЗначениеПоУмолчанию - Произвольный - значение по умолчанию; Неопределено — не задано.
//  Обязательный - Булево - Истина, если параметр обязателен.
//  ДопустимыеЗначения - Строка - допустимые значения через запятую.
//
// Возвращаемое значение:
//  Структура - описание параметра инструмента.
//
Функция ОписаниеПараметра(Имя, Тип, Описание, ЗначениеПоУмолчанию = Неопределено, Обязательный = Ложь, ДопустимыеЗначения = "")

	Параметр = Новый Структура;
	Параметр.Вставить("Имя", Имя);
	Параметр.Вставить("Вид", "Простой");
	Параметр.Вставить("Тип", Тип);
	Параметр.Вставить("Описание", Описание);
	Параметр.Вставить("ЗначениеПоУмолчанию", ЗначениеПоУмолчанию);
	Параметр.Вставить("Обязательный", Обязательный);
	Параметр.Вставить("ДопустимыеЗначения", ДопустимыеЗначения);

	Возврат Параметр;

КонецФункции

// Создаёт описание параметра-массива инструмента для построения JSON-схемы.
//
// Параметры:
//  Имя - Строка - имя параметра.
//  ТипЭлемента - Строка - тип элементов массива в терминах JSON Schema.
//  Описание - Строка - описание параметра для ассистента.
//  ДопустимыеЗначенияЭлемента - Строка - допустимые значения элементов через запятую.
//  Обязательный - Булево - Истина, если параметр обязателен.
//
// Возвращаемое значение:
//  Структура - описание параметра-массива.
//
Функция ОписаниеПараметраМассив(Имя, ТипЭлемента, Описание, ДопустимыеЗначенияЭлемента = "", Обязательный = Ложь)

	Параметр = Новый Структура;
	Параметр.Вставить("Имя", Имя);
	Параметр.Вставить("Вид", "Массив");
	Параметр.Вставить("Описание", Описание);
	Параметр.Вставить("ТипЭлемента", ТипЭлемента);
	Параметр.Вставить("ДопустимыеЗначенияЭлемента", ДопустимыеЗначенияЭлемента);
	Параметр.Вставить("Обязательный", Обязательный);

	Возврат Параметр;

КонецФункции

// Формирует JSON-схему параметров инструмента по массиву их описаний.
//
// Параметры:
//  ОписанияПараметров - Массив из Структура - описания параметров,
//                       см. ОписаниеПараметра и ОписаниеПараметраМассив.
//
// Возвращаемое значение:
//  Строка - JSON-схема параметров инструмента.
//
Функция СхемаПараметровИнструмента(ОписанияПараметров)

	Свойства = Новый Структура;
	ОбязательныеПараметры = Новый Массив;

	Для Каждого Описание Из ОписанияПараметров Цикл
		СвойствоПараметра = Новый Структура;

		Если Описание.Вид = "Массив" Тогда
			СвойствоПараметра.Вставить("type", "array");
			СвойствоПараметра.Вставить("description", Описание.Описание);

			ЭлементМассива = Новый Структура;
			ЭлементМассива.Вставить("type", Описание.ТипЭлемента);
			Если Не ПустаяСтрока(Описание.ДопустимыеЗначенияЭлемента) Тогда
				ЭлементМассива.Вставить("enum", МассивДопустимыхЗначений(Описание.ДопустимыеЗначенияЭлемента));
			КонецЕсли;

			СвойствоПараметра.Вставить("items", ЭлементМассива);
		Иначе
			СвойствоПараметра.Вставить("type", Описание.Тип);
			СвойствоПараметра.Вставить("description", Описание.Описание);

			Если Описание.ЗначениеПоУмолчанию <> Неопределено Тогда
				СвойствоПараметра.Вставить("default", Описание.ЗначениеПоУмолчанию);
			КонецЕсли;

			Если Не ПустаяСтрока(Описание.ДопустимыеЗначения) Тогда
				СвойствоПараметра.Вставить("enum", МассивДопустимыхЗначений(Описание.ДопустимыеЗначения));
			КонецЕсли;
		КонецЕсли;

		Свойства.Вставить(Описание.Имя, СвойствоПараметра);

		Если Описание.Обязательный Тогда
			ОбязательныеПараметры.Добавить(Описание.Имя);
		КонецЕсли;
	КонецЦикла;

	Схема = Новый Структура;
	Схема.Вставить("type", "object");
	Схема.Вставить("properties", Свойства);
	Схема.Вставить("required", ОбязательныеПараметры);

	Возврат СхемаВJSON(Схема);

КонецФункции

// Преобразует строку со списком допустимых значений в массив.
//
// Параметры:
//  СписокЗначений - Строка - значения через запятую.
//
// Возвращаемое значение:
//  Массив из Строка - допустимые значения без пробелов по краям.
//
Функция МассивДопустимыхЗначений(СписокЗначений)

	МассивЗначений = Новый Массив;
	Для Каждого Значение Из СтрРазделить(СписокЗначений, ",", Ложь) Цикл
		МассивЗначений.Добавить(СокрЛП(Значение));
	КонецЦикла;

	Возврат МассивЗначений;

КонецФункции

// Сериализует схему параметров инструмента в строку JSON.
//
// Параметры:
//  Схема - Структура - схема параметров инструмента.
//
// Возвращаемое значение:
//  Строка - JSON-представление схемы.
//
Функция СхемаВJSON(Схема)

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Схема);

	Возврат ЗаписьJSON.Закрыть();

КонецФункции

#КонецОбласти

#КонецЕсли
