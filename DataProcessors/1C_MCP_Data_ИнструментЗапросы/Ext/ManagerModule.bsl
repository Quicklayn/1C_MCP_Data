#Область ИнструментExecuteQuery

// Выполняет запрос из аргументов инструмента и формирует текст его результатов.
//
// Параметры:
//  Аргументы - Структура - аргументы вызова инструмента,
//              элемент querytext - текст запроса на языке запросов 1С.
//
// Возвращаемое значение:
//  Строка - результаты запроса в выбранном формате.
//
Функция ВыполнитьЗапрос(Аргументы)

	ТекстЗапроса = "";
	Если Аргументы.Свойство("querytext") Тогда
		ТекстЗапроса = СокрЛП(Строка(Аргументы.querytext));
	КонецЕсли;

	Если ПустаяСтрока(ТекстЗапроса) Тогда
		ВызватьИсключение "Не передан текст запроса: параметр ""querytext"" обязателен.";
	КонецЕсли;

	Формат = ФорматИзАргументов(Аргументы);
	МаксСтрок = МаксСтрокИзАргументов(Аргументы);

	Запрос = Новый Запрос(ТекстЗапроса);
	Если Аргументы.Свойство("parameters") И Аргументы.parameters <> Неопределено Тогда
		ЗаполнитьПараметрыЗапроса(Запрос, Аргументы.parameters);
	КонецЕсли;

	РезультатыЗапроса = Запрос.ВыполнитьПакет();

	// Запрос с ПОМЕСТИТЬ возвращает результатом число помещённых записей,
	// поэтому его результат распознаётся отдельно от результатов выборки.
	ЕстьВременныеТаблицы = СтрНайти(ВРег(ТекстЗапроса), "ПОМЕСТИТЬ") > 0
		ИЛИ СтрНайти(ВРег(ТекстЗапроса), "УНИЧТОЖИТЬ") > 0;

	РезультатыВывода = Новый Массив;
	Для Каждого Результат Из РезультатыЗапроса Цикл
		Если Результат.Колонки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если ЭтоРезультатВременнойТаблицы(Результат, ЕстьВременныеТаблицы) Тогда
			Продолжить;
		КонецЕсли;
		РезультатыВывода.Добавить(Результат);
	КонецЦикла;

	Если РезультатыВывода.Количество() = 0 Тогда
		ВызватьИсключение "В пакете запросов нет результата с колонками: выводить нечего.";
	КонецЕсли;

	Если Формат = "json" Тогда
		Возврат РезультатыВJSON(РезультатыВывода, МаксСтрок);
	КонецЕсли;

	БлокиРезультатов = Новый Массив;
	Для Индекс = 1 По РезультатыВывода.Количество() Цикл
		ТекстТаблицы = ТаблицаРезультатаВТекст(РезультатыВывода[Индекс - 1], Формат, МаксСтрок);
		Если РезультатыВывода.Количество() = 1 Тогда
			БлокиРезультатов.Добавить(ТекстТаблицы);
		Иначе
			БлокиРезультатов.Добавить("Результат " + Индекс + ":" + Символы.ПС + ТекстТаблицы);
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(БлокиРезультатов, Символы.ПС + Символы.ПС);

КонецФункции

// Заполняет параметры запроса значениями из структуры.
//
// Параметры:
//  Запрос - Запрос - запрос, которому назначаются параметры.
//  Параметры - Структура - значения параметров; ключ — имя параметра без "&".
//
Процедура ЗаполнитьПараметрыЗапроса(Запрос, Параметры)

	Если ТипЗнч(Параметры) <> Тип("Структура") Тогда
		ВызватьИсключение "Параметр ""parameters"" должен быть объектом.";
	КонецЕсли;

	Для Каждого Элемент Из Параметры Цикл
		ИмяПараметра = Строка(Элемент.Ключ);
		Если Лев(ИмяПараметра, 1) = "&" Тогда
			ИмяПараметра = Сред(ИмяПараметра, 2);
		КонецЕсли;
		Если ПустаяСтрока(ИмяПараметра) Тогда
			ВызватьИсключение "Имя параметра запроса не может быть пустым.";
		КонецЕсли;
		Запрос.УстановитьПараметр(ИмяПараметра, ЗначениеПараметраЗапроса(Элемент.Значение));
	КонецЦикла;

КонецПроцедуры

// Преобразует значение из JSON-аргумента в значение параметра запроса.
//
// Параметры:
//  Значение - Произвольный - значение из аргументов инструмента.
//
// Возвращаемое значение:
//  Произвольный - значение для Запрос.УстановитьПараметр.
//
Функция ЗначениеПараметраЗапроса(Значение)

	ТипЗначения = ТипЗнч(Значение);

	Если ТипЗначения = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Результат.Добавить(ЗначениеПараметраЗапроса(Элемент));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	Если ТипЗначения = Тип("Структура") Тогда
		Возврат ЗначениеПараметраИзСтруктуры(Значение);
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Преобразует типизированное описание значения в значение параметра запроса.
//
// Параметры:
//  Описание - Структура - объект с полем type и value либо с полями metaType и uuid.
//
// Возвращаемое значение:
//  Произвольный - значение для Запрос.УстановитьПараметр.
//
Функция ЗначениеПараметраИзСтруктуры(Описание)

	Если НЕ Описание.Свойство("type") Тогда
		Если Описание.Свойство("metaType") И Описание.Свойство("uuid") Тогда
			Возврат СсылкаПоПолномуИмениИUUID(Описание.metaType, Описание.uuid);
		КонецЕсли;
		ВызватьИсключение "Типизированное значение параметра должно содержать поле ""type"".";
	КонецЕсли;

	Вид = НРег(СокрЛП(Строка(Описание.type)));

	Если Вид = "date" Тогда
		Если НЕ Описание.Свойство("value") Тогда
			ВызватьИсключение "Для параметра типа date не передано поле ""value"".";
		КонецЕсли;
		Возврат ДатаИзСтроки(Описание.value);
	ИначеЕсли Вид = "ref" Тогда
		Если Описание.Свойство("metaType") И Описание.Свойство("uuid") Тогда
			Возврат СсылкаПоПолномуИмениИUUID(Описание.metaType, Описание.uuid);
		КонецЕсли;
		Если НЕ Описание.Свойство("value") Тогда
			ВызватьИсключение "Для параметра типа ref не передано поле ""value"" или пара metaType/uuid.";
		КонецЕсли;
		Части = СтрРазделить(Строка(Описание.value), ":", Ложь);
		Если Части.Количество() <> 2 Тогда
			ВызватьИсключение "Для параметра типа ref ожидается значение ""<полное имя>:<uuid>"".";
		КонецЕсли;
		Возврат СсылкаПоПолномуИмениИUUID(Части[0], Части[1]);
	ИначеЕсли Вид = "number" Тогда
		Если НЕ Описание.Свойство("value") Тогда
			ВызватьИсключение "Для параметра типа number не передано поле ""value"".";
		КонецЕсли;
		Если ТипЗнч(Описание.value) = Тип("Число") Тогда
			Возврат Описание.value;
		КонецЕсли;
		Возврат Число(Строка(Описание.value));
	ИначеЕсли Вид = "string" Тогда
		Если НЕ Описание.Свойство("value") Тогда
			ВызватьИсключение "Для параметра типа string не передано поле ""value"".";
		КонецЕсли;
		Возврат Строка(Описание.value);
	ИначеЕсли Вид = "boolean" Тогда
		Если НЕ Описание.Свойство("value") Тогда
			ВызватьИсключение "Для параметра типа boolean не передано поле ""value"".";
		КонецЕсли;
		Возврат БулевоИзЗначения(Описание.value);
	ИначеЕсли Вид = "null" Тогда
		Возврат Неопределено;
	КонецЕсли;

	ВызватьИсключение "Неизвестный тип параметра: " + Вид + ". Допустимые типы: date, ref, number, string, boolean, null.";

КонецФункции

// Разбирает дату из строки в формате ISO 8601 или ГГГГ-ММ-ДД.
//
// Параметры:
//  Значение - Дата, Строка - дата.
//
// Возвращаемое значение:
//  Дата - разобранная дата.
//
Функция ДатаИзСтроки(Значение)

	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Значение;
	КонецЕсли;

	ТекстДаты = СокрЛП(Строка(Значение));
	Если ПустаяСтрока(ТекстДаты) Тогда
		ВызватьИсключение "Не передана дата.";
	КонецЕсли;

	ДатаРезультат = Неопределено;
	Попытка
		ДатаРезультат = ПрочитатьДатуJSON(ТекстДаты, ФорматДатыJSON.ISO);
	Исключение
		ДатаРезультат = Неопределено;
	КонецПопытки;

	Если ДатаРезультат = Неопределено Тогда
		Части = СтрРазделить(ТекстДаты, "-", Ложь);
		Если Части.Количество() = 3 Тогда
			Попытка
				ДатаРезультат = Дата(Число(Части[0]), Число(Части[1]), Число(Части[2]));
			Исключение
				ДатаРезультат = Неопределено;
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;

	Если ДатаРезультат = Неопределено Тогда
		ВызватьИсключение "Некорректная дата: " + ТекстДаты + ". Ожидается ISO 8601 или ГГГГ-ММ-ДД.";
	КонецЕсли;

	Возврат ДатаРезультат;

КонецФункции

// Преобразует значение в булево.
//
// Параметры:
//  Значение - Булево, Строка, Число - значение.
//
// Возвращаемое значение:
//  Булево - результат преобразования.
//
Функция БулевоИзЗначения(Значение)

	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;

	Текст = НРег(СокрЛП(Строка(Значение)));
	Если Текст = "true" ИЛИ Текст = "истина" ИЛИ Текст = "1" Тогда
		Возврат Истина;
	КонецЕсли;
	Если Текст = "false" ИЛИ Текст = "ложь" ИЛИ Текст = "0" Тогда
		Возврат Ложь;
	КонецЕсли;

	ВызватьИсключение "Не удалось преобразовать значение в булево: " + Текст;

КонецФункции

// Возвращает формат результата запроса из аргументов.
//
// Параметры:
//  Аргументы - Структура - аргументы вызова инструмента.
//
// Возвращаемое значение:
//  Строка - table, csv или json.
//
Функция ФорматИзАргументов(Аргументы)

	Формат = "table";
	Если Аргументы.Свойство("format") И НЕ ПустаяСтрока(Строка(Аргументы.format)) Тогда
		Формат = НРег(СокрЛП(Строка(Аргументы.format)));
	КонецЕсли;

	Если Формат <> "table" И Формат <> "csv" И Формат <> "json" Тогда
		ВызватьИсключение "Неизвестный формат: " + Формат + ". Допустимые форматы: table, csv, json.";
	КонецЕсли;

	Возврат Формат;

КонецФункции

// Возвращает максимум строк результата из аргументов.
//
// Параметры:
//  Аргументы - Структура - аргументы вызова инструмента.
//
// Возвращаемое значение:
//  Число - максимум строк; 0 — без ограничения.
//
Функция МаксСтрокИзАргументов(Аргументы)

	МаксСтрок = 1000;
	Если Аргументы.Свойство("maxRows") Тогда
		Попытка
			Если ТипЗнч(Аргументы.maxRows) = Тип("Число") Тогда
				МаксСтрок = Цел(Аргументы.maxRows);
			Иначе
				МаксСтрок = Цел(Число(Строка(Аргументы.maxRows)));
			КонецЕсли;
		Исключение
			ВызватьИсключение "Параметр ""maxRows"" должен быть числом.";
		КонецПопытки;
	КонецЕсли;

	Если МаксСтрок < 0 Тогда
		ВызватьИсключение "Параметр ""maxRows"" не может быть отрицательным.";
	КонецЕсли;
	Если МаксСтрок > 100000 Тогда
		МаксСтрок = 100000;
	КонецЕсли;

	Возврат МаксСтрок;

КонецФункции

// Формирует текстовую таблицу или CSV по результату запроса.
//
// Параметры:
//  Результат - РезультатЗапроса - результат выполнения запроса, содержащий колонки.
//  Формат - Строка - table или csv.
//  МаксСтрок - Число - максимум строк; 0 — без ограничения.
//
// Возвращаемое значение:
//  Строка - заголовки колонок и строки результата.
//
Функция ТаблицаРезультатаВТекст(Результат, Формат, МаксСтрок)

	Колонки = Результат.Колонки;
	Разделитель = " | ";
	Если Формат = "csv" Тогда
		Разделитель = ",";
	КонецЕсли;

	Заголовки = Новый Массив;
	Для Каждого Колонка Из Колонки Цикл
		Если Формат = "csv" Тогда
			Заголовки.Добавить(ЗначениеВCSV(Колонка.Имя));
		Иначе
			Заголовки.Добавить(ЗначениеВТекст(Колонка.Имя));
		КонецЕсли;
	КонецЦикла;

	Строки = Новый Массив;
	Строки.Добавить(СтрСоединить(Заголовки, Разделитель));

	Выборка = Результат.Выбрать();
	КоличествоСтрок = 0;
	Обрезано = Ложь;
	Пока Выборка.Следующий() Цикл
		Если МаксСтрок > 0 И КоличествоСтрок >= МаксСтрок Тогда
			Обрезано = Истина;
			Прервать;
		КонецЕсли;

		Значения = Новый Массив;
		Для Каждого Колонка Из Колонки Цикл
			Если Формат = "csv" Тогда
				Значения.Добавить(ЗначениеВCSV(Выборка[Колонка.Имя]));
			Иначе
				Значения.Добавить(ЗначениеВТекст(Выборка[Колонка.Имя]));
			КонецЕсли;
		КонецЦикла;
		Строки.Добавить(СтрСоединить(Значения, Разделитель));
		КоличествоСтрок = КоличествоСтрок + 1;
	КонецЦикла;

	Если КоличествоСтрок = 0 И Формат = "table" Тогда
		Строки.Добавить("(0 строк)");
	КонецЕсли;

	Если Обрезано И Формат = "table" Тогда
		Строки.Добавить("... (обрезано: показаны первые " + МаксСтрок + " строк)");
	КонецЕсли;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Формирует JSON-представление результатов запроса.
//
// Параметры:
//  Результаты - Массив из РезультатЗапроса - результаты с колонками.
//  МаксСтрок - Число - максимум строк на результат; 0 — без ограничения.
//
// Возвращаемое значение:
//  Строка - JSON вида {"results":[{"index","columns","rows","truncated"}]}.
//
Функция РезультатыВJSON(Результаты, МаксСтрок)

	РезультатыJSON = Новый Массив;

	Для Индекс = 1 По Результаты.Количество() Цикл
		Результат = Результаты[Индекс - 1];

		Колонки = Новый Массив;
		Для Каждого Колонка Из Результат.Колонки Цикл
			Колонки.Добавить(Колонка.Имя);
		КонецЦикла;

		Строки = Новый Массив;
		Выборка = Результат.Выбрать();
		КоличествоСтрок = 0;
		Обрезано = Ложь;
		Пока Выборка.Следующий() Цикл
			Если МаксСтрок > 0 И КоличествоСтрок >= МаксСтрок Тогда
				Обрезано = Истина;
				Прервать;
			КонецЕсли;

			СтрокаJSON = Новый Структура;
			Для Каждого Колонка Из Результат.Колонки Цикл
				СтрокаJSON.Вставить(Колонка.Имя, ЗначениеДляJSON(Выборка[Колонка.Имя]));
			КонецЦикла;
			Строки.Добавить(СтрокаJSON);
			КоличествоСтрок = КоличествоСтрок + 1;
		КонецЦикла;

		РезультатJSON = Новый Структура;
		РезультатJSON.Вставить("index", Индекс);
		РезультатJSON.Вставить("columns", Колонки);
		РезультатJSON.Вставить("rows", Строки);
		РезультатJSON.Вставить("truncated", Обрезано);
		РезультатыJSON.Добавить(РезультатJSON);
	КонецЦикла;

	Схема = Новый Структура("results", РезультатыJSON);
	Возврат СхемаВJSON(Схема);

КонецФункции

// Преобразует значение ячейки результата запроса в JSON-совместимое значение.
//
// Параметры:
//  Значение - Произвольный - значение ячейки.
//
// Возвращаемое значение:
//  Произвольный - строка, число, булево, null или структура {presentation, uuid}.
//
Функция ЗначениеДляJSON(Значение)

	Если Значение = NULL Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ТипЗначения = ТипЗнч(Значение);

	Если ТипЗначения = Тип("Дата") Тогда
		Возврат XMLСтрока(Значение);
	КонецЕсли;
	Если ТипЗначения = Тип("Число") ИЛИ ТипЗначения = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;
	Если ТипЗначения = Тип("Строка") Тогда
		Возврат ОграничитьТекст(Значение, 1000);
	КонецЕсли;
	Если ТипЗначения = Тип("ХранилищеЗначения") Тогда
		Возврат "<двоичные данные>";
	КонецЕсли;
	Если ТипЗначения = Тип("УникальныйИдентификатор") Тогда
		Возврат XMLСтрока(Значение);
	КонецЕсли;

	UUID = "";
	Попытка
		UUID = XMLСтрока(Значение);
	Исключение
		UUID = "";
	КонецПопытки;

	Представление = ЗначениеВТекст(Значение);
	Если СтрДлина(UUID) = 36 И СтрНайти(UUID, "-") > 0 Тогда
		Возврат Новый Структура("presentation,uuid", Представление, UUID);
	КонецЕсли;

	Возврат Представление;

КонецФункции

// Определяет, что результат запроса — число записей, помещённых во временную таблицу.
//
// Параметры:
//  Результат - РезультатЗапроса - результат выполнения запроса.
//  ЕстьВременныеТаблицы - Булево - Истина, если в тексте пакета есть ПОМЕСТИТЬ или УНИЧТОЖИТЬ.
//
// Возвращаемое значение:
//  Булево - Истина, если результат является служебным и не выводится.
//
Функция ЭтоРезультатВременнойТаблицы(Результат, ЕстьВременныеТаблицы)

	Если НЕ ЕстьВременныеТаблицы Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Результат.Колонки.Количество() <> 1 Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ВРег(Результат.Колонки[0].Имя) = "КОЛИЧЕСТВО";

КонецФункции

#КонецОбласти

#Область ИнструментGetObject

// Читает объект по ссылке и формирует текстовый результат.
//
// Параметры:
//  Аргументы - Структура - аргументы вызова инструмента.
//
// Возвращаемое значение:
//  Строка - реквизиты объекта и, при необходимости, табличные части.
//
Функция ПрочитатьОбъект(Аргументы)

	Тип = ПолноеИмяИзАргументов(Аргументы);
	UUID = UUIDИзАргументов(Аргументы);

	МетаданныеОбъекта = МетаданныеПоПолномуИмени(Тип);
	ТипСсылки = ТипСсылкиПоМетаданным(МетаданныеОбъекта);
	Если ТипСсылки = Неопределено Тогда
		ВызватьИсключение "Тип """ + Тип + """ не поддерживает ссылки.";
	КонецЕсли;

	Ссылка = СсылкаПоТипуИUUID(ТипСсылки, UUID);

	Поля = ПоляОбъекта(МетаданныеОбъекта, Аргументы);
	ПоляЗапроса = Новый Массив;
	Для Каждого ИмяПоля Из Поля Цикл
		ПоляЗапроса.Добавить("Т." + ИмяПоля);
	КонецЦикла;

	ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ 1 " + СтрСоединить(ПоляЗапроса, ", ")
		+ " ИЗ " + МетаданныеОбъекта.ПолноеИмя() + " КАК Т"
		+ " ГДЕ Т.Ссылка = &Ссылка";

	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();

	Если НЕ Выборка.Следующий() Тогда
		Возврат "Объект не найден: " + МетаданныеОбъекта.ПолноеИмя() + " " + UUID;
	КонецЕсли;

	Строки = Новый Массив;
	Строки.Добавить(МетаданныеОбъекта.ПолноеИмя() + ": " + XMLСтрока(Ссылка));
	Для Каждого ИмяПоля Из Поля Цикл
		Строки.Добавить(ИмяПоля + ": " + ЗначениеВТекст(Выборка[ИмяПоля]));
	КонецЦикла;

	Если ВключитьТабличныеЧасти(Аргументы) Тогда
		ДобавитьТабличныеЧастиВТекст(Строки, МетаданныеОбъекта, Ссылка, Аргументы);
	КонецЕсли;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Возвращает массив имён полей объекта для выборки.
//
// Параметры:
//  МетаданныеОбъекта - ОбъектМетаданных - объект метаданных.
//  Аргументы - Структура - аргументы вызова инструмента.
//
// Возвращаемое значение:
//  Массив из Строка - имена стандартных реквизитов и реквизитов.
//
Функция ПоляОбъекта(МетаданныеОбъекта, Аргументы)

	Имена = Новый Массив;
	ДобавитьИменаРеквизитов(Имена, СвойствоМетаданных(МетаданныеОбъекта, "СтандартныеРеквизиты"));
	ДобавитьИменаРеквизитов(Имена, СвойствоМетаданных(МетаданныеОбъекта, "Реквизиты"));

	Если Имена.Найти("Ссылка") = Неопределено Тогда
		Имена.Вставить(0, "Ссылка");
	КонецЕсли;

	Если НЕ Аргументы.Свойство("fields") Тогда
		Возврат Имена;
	КонецЕсли;

	Если ТипЗнч(Аргументы.fields) <> Тип("Массив") Тогда
		ВызватьИсключение "Параметр ""fields"" должен быть массивом имён полей.";
	КонецЕсли;

	Выбранные = Новый Массив;
	Для Каждого ЗначениеИмени Из Аргументы.fields Цикл
		ИмяПоля = СокрЛП(Строка(ЗначениеИмени));
		Если ПустаяСтрока(ИмяПоля) Тогда
			Продолжить;
		КонецЕсли;
		Если Имена.Найти(ИмяПоля) = Неопределено Тогда
			ВызватьИсключение "Поле """ + ИмяПоля + """ не найдено. Доступные поля: " + СтрСоединить(Имена, ", ");
		КонецЕсли;
		Если Выбранные.Найти(ИмяПоля) = Неопределено Тогда
			Выбранные.Добавить(ИмяПоля);
		КонецЕсли;
	КонецЦикла;

	Если Выбранные.Количество() = 0 Тогда
		ВызватьИсключение "Параметр ""fields"" не содержит имён полей.";
	КонецЕсли;

	Возврат Выбранные;

КонецФункции

// Добавляет имена реквизитов из коллекции метаданных в массив.
//
// Параметры:
//  Имена - Массив из Строка - массив имён.
//  Реквизиты - КоллекцияОбъектовМетаданных, Неопределено - коллекция реквизитов.
//
Процедура ДобавитьИменаРеквизитов(Имена, Реквизиты)

	Если Реквизиты = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Реквизит Из Реквизиты Цикл
		Если Имена.Найти(Реквизит.Имя) = Неопределено Тогда
			Имена.Добавить(Реквизит.Имя);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Добавляет табличные части объекта в текстовый результат.
//
// Параметры:
//  Строки - Массив из Строка - формируемый результат.
//  МетаданныеОбъекта - ОбъектМетаданных - объект метаданных.
//  Ссылка - Ссылка - ссылка на объект.
//  Аргументы - Структура - аргументы вызова инструмента.
//
Процедура ДобавитьТабличныеЧастиВТекст(Строки, МетаданныеОбъекта, Ссылка, Аргументы)

	ТабличныеЧасти = СвойствоМетаданных(МетаданныеОбъекта, "ТабличныеЧасти");
	Если ТабличныеЧасти = Неопределено ИЛИ ТабличныеЧасти.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	МаксСтрок = МаксТабличныхСтрокИзАргументов(Аргументы);
	ТекстМаксСтрок = Формат(МаксСтрок, "ЧГ=0");

	Запросы = Новый Массив;
	Для Каждого ТабличнаяЧасть Из ТабличныеЧасти Цикл
		ПоляТЧ = Новый Массив;
		ПоляТЧ.Добавить("Т.НомерСтроки");
		Для Каждого Реквизит Из ТабличнаяЧасть.Реквизиты Цикл
			ПоляТЧ.Добавить("Т." + Реквизит.Имя);
		КонецЦикла;

		Запросы.Добавить(
			"ВЫБРАТЬ ПЕРВЫЕ " + ТекстМаксСтрок + " "
			+ СтрСоединить(ПоляТЧ, ", ")
			+ " ИЗ " + МетаданныеОбъекта.ПолноеИмя() + "." + ТабличнаяЧасть.Имя + " КАК Т"
			+ " ГДЕ Т.Ссылка = &Ссылка"
			+ " УПОРЯДОЧИТЬ ПО Т.НомерСтроки"
		);
	КонецЦикла;

	Пакет = Новый Запрос(СтрСоединить(Запросы, ";"));
	Пакет.УстановитьПараметр("Ссылка", Ссылка);
	Результаты = Пакет.ВыполнитьПакет();

	Индекс = 0;
	Для Каждого ТабличнаяЧасть Из ТабличныеЧасти Цикл
		Строки.Добавить("");
		Строки.Добавить("Табличная часть """ + ТабличнаяЧасть.Имя + """:");
		Строки.Добавить(ТаблицаРезультатаВТекст(Результаты[Индекс], "table", МаксСтрок));
		Индекс = Индекс + 1;
	КонецЦикла;

КонецПроцедуры

// Возвращает признак включения табличных частей.
//
// Параметры:
//  Аргументы - Структура - аргументы вызова инструмента.
//
// Возвращаемое значение:
//  Булево - Истина, если табличные части нужно вывести.
//
Функция ВключитьТабличныеЧасти(Аргументы)

	Если НЕ Аргументы.Свойство("includeTabularSections") Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат БулевоИзЗначения(Аргументы.includeTabularSections);

КонецФункции

// Возвращает максимум строк табличной части из аргументов.
//
// Параметры:
//  Аргументы - Структура - аргументы вызова инструмента.
//
// Возвращаемое значение:
//  Число - максимум строк, от 1 до 1000.
//
Функция МаксТабличныхСтрокИзАргументов(Аргументы)

	МаксСтрок = 100;
	Если Аргументы.Свойство("maxTabularRows") Тогда
		Попытка
			Если ТипЗнч(Аргументы.maxTabularRows) = Тип("Число") Тогда
				МаксСтрок = Цел(Аргументы.maxTabularRows);
			Иначе
				МаксСтрок = Цел(Число(Строка(Аргументы.maxTabularRows)));
			КонецЕсли;
		Исключение
			ВызватьИсключение "Параметр ""maxTabularRows"" должен быть числом.";
		КонецПопытки;
	КонецЕсли;

	Если МаксСтрок < 1 Тогда
		ВызватьИсключение "Параметр ""maxTabularRows"" должен быть больше нуля.";
	КонецЕсли;
	Если МаксСтрок > 1000 Тогда
		МаксСтрок = 1000;
	КонецЕсли;

	Возврат МаксСтрок;

КонецФункции

#КонецОбласти

#Область ИнструментFindReferences

// Ищет ссылки на объект и формирует текстовый результат.
//
// Параметры:
//  Аргументы - Структура - аргументы вызова инструмента.
//
// Возвращаемое значение:
//  Строка - список полей с количеством ссылок.
//
Функция НайтиСсылки(Аргументы)

	Тип = ПолноеИмяИзАргументов(Аргументы);
	UUID = UUIDИзАргументов(Аргументы);

	МетаданныеОбъекта = МетаданныеПоПолномуИмени(Тип);
	ТипСсылки = ТипСсылкиПоМетаданным(МетаданныеОбъекта);
	Если ТипСсылки = Неопределено Тогда
		ВызватьИсключение "Тип """ + Тип + """ не поддерживает ссылки.";
	КонецЕсли;

	Ссылка = СсылкаПоТипуИUUID(ТипСсылки, UUID);
	МаксПроверок = МаксПроверокИзАргументов(Аргументы);
	Кандидаты = КандидатыСсылок(ТипСсылки);

	Если Кандидаты.Количество() = 0 Тогда
		Возврат "Ссылки не найдены. Подходящих полей метаданных не обнаружено.";
	КонецЕсли;

	КонецПроверки = Кандидаты.Количество();
	Если КонецПроверки > МаксПроверок Тогда
		КонецПроверки = МаксПроверок;
	КонецЕсли;

	Проверяемые = Новый Массив;
	Для Индекс = 1 По КонецПроверки Цикл
		Проверяемые.Добавить(Кандидаты[Индекс - 1]);
	КонецЦикла;

	Части = Новый Массив;
	Для Индекс = 1 По Проверяемые.Количество() Цикл
		Кандидат = Проверяемые[Индекс - 1];
		Части.Добавить(
			"ВЫБРАТЬ " + Индекс + " КАК Номер, КОЛИЧЕСТВО(*) КАК Количество"
			+ " ИЗ " + Кандидат.Таблица + " КАК Т"
			+ " ГДЕ Т." + Кандидат.Поле + " = &Ссылка"
		);
	КонецЦикла;

	Запрос = Новый Запрос(СтрСоединить(Части, " ОБЪЕДИНИТЬ ВСЕ "));
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();

	Найденные = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Если Выборка.Количество > 0 Тогда
			Кандидат = Проверяемые[Выборка.Номер - 1];
			Найденные.Добавить(Кандидат.Представление + ": " + Выборка.Количество);
		КонецЕсли;
	КонецЦикла;

	Итог = Новый Массив;
	Итог.Добавить("Ссылки на " + МетаданныеОбъекта.ПолноеИмя() + " " + UUID + ":");

	Если Найденные.Количество() = 0 Тогда
		Если Кандидаты.Количество() > Проверяемые.Количество() Тогда
			Итог.Добавить("Среди проверенных полей ссылки не найдены.");
		Иначе
			Итог.Добавить("Ссылки не найдены.");
		КонецЕсли;
	Иначе
		Для Каждого Строка Из Найденные Цикл
			Итог.Добавить(Строка);
		КонецЦикла;
	КонецЕсли;

	Итог.Добавить("Проверено полей: " + Проверяемые.Количество() + " из " + Кандидаты.Количество() + ".");
	Если Кандидаты.Количество() > Проверяемые.Количество() Тогда
		Итог.Добавить("Проверены не все поля; увеличьте maxTables, чтобы охватить остальные.");
	КонецЕсли;

	Возврат СтрСоединить(Итог, Символы.ПС);

КонецФункции

// Формирует список полей метаданных, которые могут ссылаться на тип.
//
// Параметры:
//  ТипСсылки - Тип - тип ссылки искомого объекта.
//
// Возвращаемое значение:
//  Массив из Структура - элементы с полями Таблица, Поле, Представление.
//
Функция КандидатыСсылок(ТипСсылки)

	Кандидаты = Новый Массив;

	// Сначала проверяются табличные части документов и регистры: в типовых
	// конфигурациях ссылки на номенклатуру и другие объекты чаще всего
	// находятся в строках документов и в измерениях регистров.
	ДобавитьКандидатовИзТабличныхЧастейДокументов(Кандидаты, ТипСсылки);
	ДобавитьКандидатовИзКоллекции(Кандидаты, Метаданные.Документы, ТипСсылки, Ложь, Ложь);
	ДобавитьКандидатовИзКоллекции(Кандидаты, Метаданные.РегистрыНакопления, ТипСсылки, Истина);
	ДобавитьКандидатовИзКоллекции(Кандидаты, Метаданные.РегистрыСведений, ТипСсылки, Истина);
	ДобавитьКандидатовИзКоллекции(Кандидаты, Метаданные.РегистрыБухгалтерии, ТипСсылки, Истина);
	ДобавитьКандидатовИзКоллекции(Кандидаты, Метаданные.РегистрыРасчета, ТипСсылки, Истина);
	ДобавитьКандидатовИзКоллекции(Кандидаты, Метаданные.Справочники, ТипСсылки, Ложь);
	ДобавитьКандидатовИзКоллекции(Кандидаты, Метаданные.ПланыВидовХарактеристик, ТипСсылки, Ложь);
	ДобавитьКандидатовИзКоллекции(Кандидаты, Метаданные.ПланыСчетов, ТипСсылки, Ложь);
	ДобавитьКандидатовИзКоллекции(Кандидаты, Метаданные.ПланыВидовРасчета, ТипСсылки, Ложь);
	ДобавитьКандидатовИзКоллекции(Кандидаты, Метаданные.ПланыОбмена, ТипСсылки, Ложь);
	ДобавитьКандидатовИзКоллекции(Кандидаты, Метаданные.БизнесПроцессы, ТипСсылки, Ложь);
	ДобавитьКандидатовИзКоллекции(Кандидаты, Метаданные.Задачи, ТипСсылки, Ложь);
	ДобавитьКандидатовИзКонстант(Кандидаты, ТипСсылки);

	Возврат Кандидаты;

КонецФункции

// Добавляет кандидатов из табличных частей документов.
//
// Табличные части документов проверяются первыми: в типовых конфигурациях
// ссылки на номенклатуру и другие объекты чаще всего находятся в строках
// документов.
//
// Параметры:
//  Кандидаты - Массив из Структура - список кандидатов.
//  ТипСсылки - Тип - тип ссылки искомого объекта.
//
Процедура ДобавитьКандидатовИзТабличныхЧастейДокументов(Кандидаты, ТипСсылки)

	Для Каждого Документ Из Метаданные.Документы Цикл
		ТабличныеЧасти = СвойствоМетаданных(Документ, "ТабличныеЧасти");
		Если ТабличныеЧасти = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого ТабличнаяЧасть Из ТабличныеЧасти Цикл
			ДобавитьКандидатовИзРеквизитов(
				Кандидаты,
				ТабличнаяЧасть.Реквизиты,
				Документ.ПолноеИмя() + "." + ТабличнаяЧасть.Имя,
				ТипСсылки
			);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Добавляет кандидатов из коллекции объектов метаданных.
//
// Параметры:
//  Кандидаты - Массив из Структура - список кандидатов.
//  Коллекция - КоллекцияОбъектовМетаданных - коллекция объектов.
//  ТипСсылки - Тип - тип ссылки искомого объекта.
//  ЭтоРегистр - Булево - Истина для коллекций регистров.
//  ДобавлятьТабличныеЧасти - Булево - Истина, если нужно добавить табличные части объектов.
//
Процедура ДобавитьКандидатовИзКоллекции(Кандидаты, Коллекция, ТипСсылки, ЭтоРегистр, ДобавлятьТабличныеЧасти = Истина)

	Для Каждого МетаданныеОбъекта Из Коллекция Цикл
		ПолноеИмя = МетаданныеОбъекта.ПолноеИмя();

		ДобавитьКандидатовИзРеквизитов(
			Кандидаты,
			СвойствоМетаданных(МетаданныеОбъекта, "СтандартныеРеквизиты"),
			ПолноеИмя,
			ТипСсылки
		);

		Если ЭтоРегистр Тогда
			ДобавитьКандидатовИзРеквизитов(Кандидаты, СвойствоМетаданных(МетаданныеОбъекта, "Измерения"), ПолноеИмя, ТипСсылки);
			ДобавитьКандидатовИзРеквизитов(Кандидаты, СвойствоМетаданных(МетаданныеОбъекта, "Ресурсы"), ПолноеИмя, ТипСсылки);
			ДобавитьКандидатовИзРеквизитов(Кандидаты, СвойствоМетаданных(МетаданныеОбъекта, "Реквизиты"), ПолноеИмя, ТипСсылки);
		Иначе
			ДобавитьКандидатовИзРеквизитов(Кандидаты, СвойствоМетаданных(МетаданныеОбъекта, "Реквизиты"), ПолноеИмя, ТипСсылки);

			Если ДобавлятьТабличныеЧасти Тогда
				ТабличныеЧасти = СвойствоМетаданных(МетаданныеОбъекта, "ТабличныеЧасти");
				Если ТабличныеЧасти <> Неопределено Тогда
					Для Каждого ТабличнаяЧасть Из ТабличныеЧасти Цикл
						ДобавитьКандидатовИзРеквизитов(
							Кандидаты,
							ТабличнаяЧасть.Реквизиты,
							ПолноеИмя + "." + ТабличнаяЧасть.Имя,
							ТипСсылки
						);
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Добавляет кандидатов из коллекции реквизитов.
//
// Параметры:
//  Кандидаты - Массив из Структура - список кандидатов.
//  Реквизиты - КоллекцияОбъектовМетаданных, Неопределено - реквизиты.
//  Таблица - Строка - имя таблицы или табличной части.
//  ТипСсылки - Тип - тип ссылки искомого объекта.
//
Процедура ДобавитьКандидатовИзРеквизитов(Кандидаты, Реквизиты, Таблица, ТипСсылки)

	Если Реквизиты = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Реквизит Из Реквизиты Цикл
		Если Реквизит.Имя = "Ссылка" Тогда
			Продолжить;
		КонецЕсли;

		Если ТипСодержит(Реквизит.Тип, ТипСсылки) Тогда
			Кандидат = Новый Структура;
			Кандидат.Вставить("Таблица", Таблица);
			Кандидат.Вставить("Поле", Реквизит.Имя);
			Кандидат.Вставить("Представление", Таблица + "." + Реквизит.Имя);
			Кандидаты.Добавить(Кандидат);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Добавляет кандидатов из констант.
//
// Параметры:
//  Кандидаты - Массив из Структура - список кандидатов.
//  ТипСсылки - Тип - тип ссылки искомого объекта.
//
Процедура ДобавитьКандидатовИзКонстант(Кандидаты, ТипСсылки)

	Для Каждого Константа Из Метаданные.Константы Цикл
		Если ТипСодержит(Константа.Тип, ТипСсылки) Тогда
			Таблица = "Константа." + Константа.Имя;
			Кандидат = Новый Структура;
			Кандидат.Вставить("Таблица", Таблица);
			Кандидат.Вставить("Поле", "Значение");
			Кандидат.Вставить("Представление", Таблица + ".Значение");
			Кандидаты.Добавить(Кандидат);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Проверяет, входит ли тип в описание типов.
//
// Параметры:
//  ОписаниеТипов - ОписаниеТипов, Неопределено - описание типов.
//  Тип - Тип - проверяемый тип.
//
// Возвращаемое значение:
//  Булево - Истина, если тип входит в описание.
//
Функция ТипСодержит(ОписаниеТипов, Тип)

	Если ОписаниеТипов = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Типы = ОписаниеТипов.Типы();
	Возврат Типы.Найти(Тип) <> Неопределено;

КонецФункции

// Возвращает максимум проверяемых полей из аргументов.
//
// Параметры:
//  Аргументы - Структура - аргументы вызова инструмента.
//
// Возвращаемое значение:
//  Число - максимум проверяемых полей, от 1 до 500.
//
Функция МаксПроверокИзАргументов(Аргументы)

	МаксПроверок = 50;
	Если Аргументы.Свойство("maxTables") Тогда
		Попытка
			Если ТипЗнч(Аргументы.maxTables) = Тип("Число") Тогда
				МаксПроверок = Цел(Аргументы.maxTables);
			Иначе
				МаксПроверок = Цел(Число(Строка(Аргументы.maxTables)));
			КонецЕсли;
		Исключение
			ВызватьИсключение "Параметр ""maxTables"" должен быть числом.";
		КонецПопытки;
	КонецЕсли;

	Если МаксПроверок < 1 Тогда
		МаксПроверок = 50;
	КонецЕсли;
	Если МаксПроверок > 500 Тогда
		МаксПроверок = 500;
	КонецЕсли;

	Возврат МаксПроверок;

КонецФункции

#КонецОбласти

#Область ИнструментGetConfigurationInfo

// Возвращает сведения о конфигурации и текущем пользователе.
//
// Параметры:
//  Аргументы - Структура - аргументы вызова инструмента (не используются).
//
// Возвращаемое значение:
//  Строка - сведения о конфигурации.
//
Функция ИнформацияОКонфигурации(Аргументы)

	Строки = Новый Массив;
	Строки.Добавить("Конфигурация: " + ТекстИлиПрочерк(Метаданные.Имя));
	Строки.Добавить("Синоним: " + ТекстИлиПрочерк(Метаданные.Синоним));
	Строки.Добавить("Версия: " + ТекстИлиПрочерк(Метаданные.Версия));
	Строки.Добавить("Режим совместимости: " + ТекстИлиПрочерк(Метаданные.РежимСовместимости));
	Строки.Добавить("Вариант встроенного языка: " + ТекстИлиПрочерк(Метаданные.ВариантВстроенногоЯзыка));
	СисИнфо = Новый СистемнаяИнформация;
	Строки.Добавить("Платформа: " + ТекстИлиПрочерк(СисИнфо.ВерсияПриложения));

	Пользователь = Пользователи.ТекущийПользователь();
	Если Пользователь = Неопределено Тогда
		Строки.Добавить("Пользователь: не определен");
	Иначе
		Строки.Добавить("Пользователь: " + ТекстИлиПрочерк(Пользователь));
	КонецЕсли;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

#КонецОбласти

#Область ИнструментCheckRights

// Проверяет право текущего пользователя на объект метаданных.
//
// Параметры:
//  Аргументы - Структура - аргументы вызова инструмента.
//
// Возвращаемое значение:
//  Строка - результат проверки.
//
Функция ПроверитьПраво(Аргументы)

	Тип = ПолноеИмяИзАргументов(Аргументы);

	Если НЕ Аргументы.Свойство("right") Тогда
		ВызватьИсключение "Не передан параметр ""right"".";
	КонецЕсли;

	Право = ПравоПоИмени(Аргументы.right);
	МетаданныеОбъекта = МетаданныеПоПолномуИмени(Тип);
	Разрешено = ПравоДоступа(Право, МетаданныеОбъекта);

	Пользователь = Пользователи.ТекущийПользователь();
	Если Пользователь = Неопределено Тогда
		ТекстПользователя = "не определен";
	Иначе
		ТекстПользователя = ТекстИлиПрочерк(Пользователь);
	КонецЕсли;

	Если Разрешено Тогда
		Результат = "разрешено";
	Иначе
		Результат = "запрещено";
	КонецЕсли;

	Возврат "Право """ + Право + """ на " + МетаданныеОбъекта.ПолноеИмя() + ": " + Результат + "."
		+ Символы.ПС + "Пользователь: " + ТекстПользователя;

КонецФункции

// Преобразует имя права в имя права 1С.
//
// Параметры:
//  Значение - Строка - имя права.
//
// Возвращаемое значение:
//  Строка - имя права для ПравоДоступа.
//
Функция ПравоПоИмени(Значение)

	Имя = НРег(СокрЛП(Строка(Значение)));

	Если Имя = "read" ИЛИ Имя = "чтение" Тогда
		Возврат "Чтение";
	ИначеЕсли Имя = "insert" ИЛИ Имя = "create" ИЛИ Имя = "добавление" Тогда
		Возврат "Добавление";
	ИначеЕсли Имя = "update" ИЛИ Имя = "изменение" Тогда
		Возврат "Изменение";
	ИначеЕсли Имя = "delete" ИЛИ Имя = "удаление" Тогда
		Возврат "Удаление";
	ИначеЕсли Имя = "post" ИЛИ Имя = "проведение" Тогда
		Возврат "Проведение";
	ИначеЕсли Имя = "view" ИЛИ Имя = "просмотр" Тогда
		Возврат "Просмотр";
	ИначеЕсли Имя = "interactiveinsert" ИЛИ Имя = "интерактивноедобавление" Тогда
		Возврат "ИнтерактивноеДобавление";
	ИначеЕсли Имя = "interactiveupdate" ИЛИ Имя = "интерактивноеизменение" Тогда
		Возврат "ИнтерактивноеИзменение";
	ИначеЕсли Имя = "interactivedelete" ИЛИ Имя = "интерактивноеудаление" Тогда
		Возврат "ИнтерактивноеУдаление";
	ИначеЕсли Имя = "interactivepost" ИЛИ Имя = "интерактивноепроведение" Тогда
		Возврат "ИнтерактивноеПроведение";
	ИначеЕсли Имя = "inputbystring" ИЛИ Имя = "вводпостроке" Тогда
		Возврат "ВводПоСтроке";
	КонецЕсли;

	ВызватьИсключение "Неизвестное право: " + Имя + ". Допустимые права: read, insert, update, delete, post, view.";

КонецФункции

