// Инструмент MCP: выполнение запроса на языке запросов 1С к текущей информационной базе.
//
// Результат возвращается текстовой таблицей: первая строка — заголовки колонок,
// далее строки, значения разделены " | ". Пустой результат — заголовки и строка "(0 строк)".
// Ошибку выполнения возвращает диспетчер MCP, поэтому собственный перехват ошибок
// в инструменте не выполняется.

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Добавляет инструменты обработки-контейнера в таблицу инструментов сервера MCP.
//
// Обращение к общим модулям расширения MCP_Сервер из этого расширения не компилируется,
// поэтому строка инструмента и JSON-схема его параметров строятся локально
// по контракту mcp_Метаданные.ДобавитьИнструмент и mcp_Метаданные.СхемаПараметровИнструмента.
//
// Параметры:
//  Инструменты - ТаблицаЗначений - таблица инструментов сервера MCP с колонками
//                ИмяОбработкиКонтейнера, Имя, Описание, СхемаПараметров.
//
Процедура ДобавитьИнструменты(Инструменты) Экспорт

	МассивПараметров = Новый Массив;

	МассивПараметров.Добавить(ОписаниеПараметра(
		"querytext",
		"string",
		"Текст запроса на языке запросов 1С к текущей информационной базе. Допускается пакет запросов, разделённых символом "";"".",
		Истина
	));

	СтрокаИнструмента = Инструменты.Добавить();
	СтрокаИнструмента.Имя = "execute_query";
	СтрокаИнструмента.Описание = "Выполняет запрос на языке запросов 1С к текущей информационной базе и возвращает результат текстовой таблицей: первая строка — заголовки колонок, далее строки со значениями через "" | "". Пустой результат — заголовки и ""(0 строк)"". Пакет запросов выводится по результатам, промежуточные временные таблицы не выводятся.";
	СтрокаИнструмента.СхемаПараметров = СхемаПараметровИнструмента(МассивПараметров);

КонецПроцедуры

// Выполняет инструмент сервера MCP по имени.
//
// Параметры:
//  ИмяИнструмента - Строка - имя инструмента, объявленного в ДобавитьИнструменты.
//  Аргументы - Структура - аргументы вызова инструмента.
//
// Возвращаемое значение:
//  Строка - текстовый результат выполнения инструмента.
//
Функция ВыполнитьИнструмент(ИмяИнструмента, Аргументы) Экспорт

	Если ИмяИнструмента = "execute_query" Тогда
		Возврат ВыполнитьЗапрос(Аргументы);
	КонецЕсли;

	ВызватьИсключение "Неизвестный инструмент: " + ИмяИнструмента;

КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выполняет запрос из аргументов инструмента и формирует текст его результатов.
//
// Параметры:
//  Аргументы - Структура - аргументы вызова инструмента,
//              элемент querytext - текст запроса на языке запросов 1С.
//
// Возвращаемое значение:
//  Строка - таблицы результатов, разделённые пустой строкой.
//
Функция ВыполнитьЗапрос(Аргументы)

	ТекстЗапроса = "";
	Если Аргументы.Свойство("querytext") Тогда
		ТекстЗапроса = СокрЛП(Строка(Аргументы.querytext));
	КонецЕсли;

	Если ПустаяСтрока(ТекстЗапроса) Тогда
		ВызватьИсключение "Не передан текст запроса: параметр ""querytext"" обязателен.";
	КонецЕсли;

	Запрос = Новый Запрос(ТекстЗапроса);
	РезультатыЗапроса = Запрос.ВыполнитьПакет();

	// Запрос с ПОМЕСТИТЬ возвращает результатом число помещённых записей,
	// поэтому его результат распознаётся отдельно от результатов выборки.
	ЕстьВременныеТаблицы = СтрНайти(ВРег(ТекстЗапроса), "ПОМЕСТИТЬ") > 0
		ИЛИ СтрНайти(ВРег(ТекстЗапроса), "УНИЧТОЖИТЬ") > 0;

	РезультатыВывода = Новый Массив;
	Для Каждого Результат Из РезультатыЗапроса Цикл
		Если Результат.Колонки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если ЭтоРезультатВременнойТаблицы(Результат, ЕстьВременныеТаблицы) Тогда
			Продолжить;
		КонецЕсли;
		РезультатыВывода.Добавить(Результат);
	КонецЦикла;

	Если РезультатыВывода.Количество() = 0 Тогда
		ВызватьИсключение "В пакете запросов нет результата с колонками: выводить нечего.";
	КонецЕсли;

	БлокиРезультатов = Новый Массив;
	Для Индекс = 1 По РезультатыВывода.Количество() Цикл
		ТекстТаблицы = ТаблицаРезультатаВТекст(РезультатыВывода[Индекс - 1]);
		Если РезультатыВывода.Количество() = 1 Тогда
			БлокиРезультатов.Добавить(ТекстТаблицы);
		Иначе
			БлокиРезультатов.Добавить("Результат " + Индекс + ":" + Символы.ПС + ТекстТаблицы);
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(БлокиРезультатов, Символы.ПС + Символы.ПС);

КонецФункции

// Формирует текстовую таблицу по результату запроса.
//
// Колонка результата запроса (КолонкаРезультатаЗапроса) содержит только имя и тип значения,
// свойства "Заголовок" у неё нет, поэтому заголовком колонки выводится её имя (псевдоним поля).
//
// Параметры:
//  Результат - РезультатЗапроса - результат выполнения запроса, содержащий колонки.
//
// Возвращаемое значение:
//  Строка - заголовки колонок и строки результата, разделённые переводом строки.
//
Функция ТаблицаРезультатаВТекст(Результат)

	Колонки = Результат.Колонки;

	Заголовки = Новый Массив;
	Для Каждого Колонка Из Колонки Цикл
		Заголовки.Добавить(ЗначениеВТекст(Колонка.Имя));
	КонецЦикла;

	Строки = Новый Массив;
	Строки.Добавить(СтрСоединить(Заголовки, " | "));

	Выборка = Результат.Выбрать();
	КоличествоСтрок = 0;
	Пока Выборка.Следующий() Цикл
		Значения = Новый Массив;
		Для Каждого Колонка Из Колонки Цикл
			Значения.Добавить(ЗначениеВТекст(Выборка[Колонка.Имя]));
		КонецЦикла;
		Строки.Добавить(СтрСоединить(Значения, " | "));
		КоличествоСтрок = КоличествоСтрок + 1;
	КонецЦикла;

	Если КоличествоСтрок = 0 Тогда
		Строки.Добавить("(0 строк)");
	КонецЕсли;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Определяет, что результат запроса — число записей, помещённых во временную таблицу.
//
// Параметры:
//  Результат - РезультатЗапроса - результат выполнения запроса.
//  ЕстьВременныеТаблицы - Булево - Истина, если в тексте пакета есть ПОМЕСТИТЬ или УНИЧТОЖИТЬ.
//
// Возвращаемое значение:
//  Булево - Истина, если результат является служебным и не выводится.
//
Функция ЭтоРезультатВременнойТаблицы(Результат, ЕстьВременныеТаблицы)

	Если НЕ ЕстьВременныеТаблицы Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Результат.Колонки.Количество() <> 1 Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ВРег(Результат.Колонки[0].Имя) = "КОЛИЧЕСТВО";

КонецФункции

// Преобразует значение ячейки результата запроса в однострочный текст.
//
// Параметры:
//  Значение - Произвольный - значение ячейки результата запроса.
//
// Возвращаемое значение:
//  Строка - строковое представление значения без переводов строк и табуляции.
//
Функция ЗначениеВТекст(Значение)

	Текст = Строка(Значение);
	Текст = СтрЗаменить(Текст, Символы.ПС, " ");
	Текст = СтрЗаменить(Текст, Символы.ВК, " ");
	Текст = СтрЗаменить(Текст, Символы.Таб, " ");

	Возврат Текст;

КонецФункции

// Создаёт описание параметра инструмента для построения JSON-схемы.
//
// Параметры:
//  Имя - Строка - имя параметра.
//  Тип - Строка - тип параметра в терминах JSON Schema, например "string".
//  Описание - Строка - описание параметра для ассистента.
//  Обязательный - Булево - Истина, если параметр обязателен.
//
// Возвращаемое значение:
//  Структура - описание параметра инструмента.
//
Функция ОписаниеПараметра(Имя, Тип, Описание, Обязательный)

	Параметр = Новый Структура;
	Параметр.Вставить("Имя", Имя);
	Параметр.Вставить("Тип", Тип);
	Параметр.Вставить("Описание", Описание);
	Параметр.Вставить("Обязательный", Обязательный);

	Возврат Параметр;

КонецФункции

// Формирует JSON-схему параметров инструмента по массиву их описаний.
//
// Параметры:
//  ОписанияПараметров - Массив из Структура - описания параметров, см. ОписаниеПараметра.
//
// Возвращаемое значение:
//  Строка - JSON-схема параметров инструмента.
//
Функция СхемаПараметровИнструмента(ОписанияПараметров)

	Свойства = Новый Структура;
	ОбязательныеПараметры = Новый Массив;

	Для Каждого Параметр Из ОписанияПараметров Цикл
		СвойствоПараметра = Новый Структура;
		СвойствоПараметра.Вставить("type", Параметр.Тип);
		СвойствоПараметра.Вставить("description", Параметр.Описание);
		Свойства.Вставить(Параметр.Имя, СвойствоПараметра);
		Если Параметр.Обязательный Тогда
			ОбязательныеПараметры.Добавить(Параметр.Имя);
		КонецЕсли;
	КонецЦикла;

	Схема = Новый Структура;
	Схема.Вставить("type", "object");
	Схема.Вставить("properties", Свойства);
	Схема.Вставить("required", ОбязательныеПараметры);

	Возврат СхемаВJSON(Схема);

КонецФункции

// Сериализует схему параметров инструмента в строку JSON.
//
// Параметры:
//  Схема - Структура - схема параметров инструмента.
//
// Возвращаемое значение:
//  Строка - JSON-представление схемы.
//
Функция СхемаВJSON(Схема)

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Схема);

	Возврат ЗаписьJSON.Закрыть();

КонецФункции

#КонецОбласти

#КонецЕсли
