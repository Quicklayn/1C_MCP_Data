// Инструменты MCP доступа к данным текущей информационной базы:
// выполнение запросов, чтение объекта по ссылке, поиск ссылок,
// сведения о конфигурации и проверка прав.
//
// Ошибку выполнения возвращает диспетчер MCP, поэтому собственный перехват ошибок
// в инструментах не выполняется. Исключения используются только для проверки
// аргументов и разбора типизированных значений.

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Добавляет инструменты обработки-контейнера в таблицу инструментов сервера MCP.
//
// Обращение к общим модулям расширения MCP_Сервер из этого расширения не компилируется,
// поэтому строка инструмента и JSON-схема его параметров строятся локально
// по контракту mcp_Метаданные.ДобавитьИнструмент и mcp_Метаданные.СхемаПараметровИнструмента.
//
// Параметры:
//  Инструменты - ТаблицаЗначений - таблица инструментов сервера MCP с колонками
//                ИмяОбработкиКонтейнера, Имя, Описание, СхемаПараметров.
//
Процедура ДобавитьИнструменты(Инструменты) Экспорт

	ДобавитьИнструментExecuteQuery(Инструменты);
	ДобавитьИнструментGetObject(Инструменты);
	ДобавитьИнструментFindReferences(Инструменты);
	ДобавитьИнструментGetConfigurationInfo(Инструменты);
	ДобавитьИнструментCheckRights(Инструменты);

КонецПроцедуры

// Выполняет инструмент сервера MCP по имени.
//
// Параметры:
//  ИмяИнструмента - Строка - имя инструмента, объявленного в ДобавитьИнструменты.
//  Аргументы - Структура - аргументы вызова инструмента.
//
// Возвращаемое значение:
//  Строка - текстовый результат выполнения инструмента.
//
Функция ВыполнитьИнструмент(ИмяИнструмента, Аргументы) Экспорт

	Если ИмяИнструмента = "execute_query" Тогда
		Возврат ВыполнитьЗапрос(Аргументы);
	ИначеЕсли ИмяИнструмента = "get_object" Тогда
		Возврат ПрочитатьОбъект(Аргументы);
	ИначеЕсли ИмяИнструмента = "find_references" Тогда
		Возврат НайтиСсылки(Аргументы);
	ИначеЕсли ИмяИнструмента = "get_configuration_info" Тогда
		Возврат ИнформацияОКонфигурации(Аргументы);
	ИначеЕсли ИмяИнструмента = "check_rights" Тогда
		Возврат ПроверитьПраво(Аргументы);
	КонецЕсли;

	ВызватьИсключение "Неизвестный инструмент: " + ИмяИнструмента;

КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

