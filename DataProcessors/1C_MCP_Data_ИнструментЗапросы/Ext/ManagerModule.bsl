// Находит объект метаданных по полному имени.
//
// Параметры:
//  ПолноеИмя - Строка - полное имя объекта метаданных.
//
// Возвращаемое значение:
//  ОбъектМетаданных - найденный объект.
//
Функция МетаданныеПоПолномуИмени(ПолноеИмя)

	Имя = СокрЛП(Строка(ПолноеИмя));
	Если ПустаяСтрока(Имя) Тогда
		ВызватьИсключение "Не передано полное имя объекта метаданных.";
	КонецЕсли;

	МетаданныеОбъекта = Метаданные.НайтиПоПолномуИмени(Имя);
	Если МетаданныеОбъекта = Неопределено Тогда
		ВызватьИсключение "Объект метаданных не найден: " + Имя;
	КонецЕсли;

	Возврат МетаданныеОбъекта;

КонецФункции

// Возвращает тип ссылки по объекту метаданных.
//
// Параметры:
//  МетаданныеОбъекта - ОбъектМетаданных - объект метаданных.
//
// Возвращаемое значение:
//  Тип, Неопределено - тип ссылки или Неопределено для нессылочного объекта.
//
Функция ТипСсылкиПоМетаданным(МетаданныеОбъекта)

	Части = СтрРазделить(МетаданныеОбъекта.ПолноеИмя(), ".", Ложь);
	Если Части.Количество() < 2 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Вид = Части[0];
	Имя = Части[1];

	Если Вид = "Справочник" Тогда
		Префикс = "СправочникСсылка";
	ИначеЕсли Вид = "Документ" Тогда
		Префикс = "ДокументСсылка";
	ИначеЕсли Вид = "ПланВидовХарактеристик" Тогда
		Префикс = "ПланВидовХарактеристикСсылка";
	ИначеЕсли Вид = "ПланСчетов" Тогда
		Префикс = "ПланСчетовСсылка";
	ИначеЕсли Вид = "ПланВидовРасчета" Тогда
		Префикс = "ПланВидовРасчетаСсылка";
	ИначеЕсли Вид = "ПланОбмена" Тогда
		Префикс = "ПланОбменаСсылка";
	ИначеЕсли Вид = "БизнесПроцесс" Тогда
		Префикс = "БизнесПроцессСсылка";
	ИначеЕсли Вид = "Задача" Тогда
		Префикс = "ЗадачаСсылка";
	Иначе
		Возврат Неопределено;
	КонецЕсли;

	Возврат Тип(Префикс + "." + Имя);

КонецФункции

// Создаёт ссылку по полному имени и UUID.
//
// Параметры:
//  ПолноеИмя - Строка - полное имя объекта метаданных.
//  UUID - Строка - UUID ссылки.
//
// Возвращаемое значение:
//  Ссылка - созданная ссылка.
//
Функция СсылкаПоПолномуИмениИUUID(ПолноеИмя, UUID)

	МетаданныеОбъекта = МетаданныеПоПолномуИмени(ПолноеИмя);
	ТипСсылки = ТипСсылкиПоМетаданным(МетаданныеОбъекта);
	Если ТипСсылки = Неопределено Тогда
		ВызватьИсключение "Тип """ + ПолноеИмя + """ не поддерживает ссылки.";
	КонецЕсли;

	Возврат СсылкаПоТипуИUUID(ТипСсылки, UUID);

КонецФункции

// Создаёт ссылку по типу и UUID.
//
// Параметры:
//  ТипСсылки - Тип - тип ссылки.
//  UUID - Строка - UUID ссылки.
//
// Возвращаемое значение:
//  Ссылка - созданная ссылка.
//
Функция СсылкаПоТипуИUUID(ТипСсылки, UUID)

	ТекстUUID = НРег(СокрЛП(Строка(UUID)));
	Если ПустаяСтрока(ТекстUUID) Тогда
		ВызватьИсключение "Не передан UUID ссылки.";
	КонецЕсли;

	Попытка
		Ссылка = XMLЗначение(ТипСсылки, ТекстUUID);
	Исключение
		ВызватьИсключение "Некорректный UUID ссылки: " + ТекстUUID;
	КонецПопытки;

	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		ВызватьИсключение "Не удалось создать ссылку по UUID: " + ТекстUUID;
	КонецЕсли;

	Возврат Ссылка;

КонецФункции

// Безопасно получает значение свойства объекта метаданных.
//
// Параметры:
//  МетаданныеОбъекта - ОбъектМетаданных - объект метаданных.
//  ИмяСвойства - Строка - имя свойства.
//
// Возвращаемое значение:
//  Произвольный, Неопределено - значение свойства или Неопределено.
//
Функция СвойствоМетаданных(МетаданныеОбъекта, ИмяСвойства)

	Обёртка = Новый Структура(ИмяСвойства);
	ЗаполнитьЗначенияСвойств(Обёртка, МетаданныеОбъекта);

	Возврат Обёртка[ИмяСвойства];

КонецФункции

// Возвращает текст значения или прочерк.
//
// Параметры:
//  Значение - Произвольный - значение.
//
// Возвращаемое значение:
//  Строка - текст значения или "-".
//
Функция ТекстИлиПрочерк(Значение)

	Если Значение = Неопределено Тогда
		Возврат "-";
	КонецЕсли;

	Текст = СокрЛП(Строка(Значение));
	Если ПустаяСтрока(Текст) Тогда
		Возврат "-";
	КонецЕсли;

	Возврат Текст;

КонецФункции

// Преобразует значение ячейки результата запроса в однострочный текст.
//
// Параметры:
//  Значение - Произвольный - значение ячейки результата запроса.
//
// Возвращаемое значение:
//  Строка - строковое представление значения без переводов строк и табуляции.
//
Функция ЗначениеВТекст(Значение)

	Если Значение = NULL Тогда
		Возврат "NULL";
	КонецЕсли;

	Попытка
		Текст = Строка(Значение);
	Исключение
		Текст = "<значение не преобразуется в строку>";
	КонецПопытки;

	Текст = СтрЗаменить(Текст, Символы.ПС, " ");
	Текст = СтрЗаменить(Текст, Символы.ВК, " ");
	Текст = СтрЗаменить(Текст, Символы.Таб, " ");

	Возврат ОграничитьТекст(Текст, 1000);

КонецФункции

// Преобразует значение в поле CSV.
//
// Параметры:
//  Значение - Произвольный - значение.
//
// Возвращаемое значение:
//  Строка - значение с экранированием запятых и кавычек.
//
Функция ЗначениеВCSV(Значение)

	Текст = ЗначениеВТекст(Значение);
	Если СтрНайти(Текст, ",") > 0 ИЛИ СтрНайти(Текст, """") > 0 Тогда
		Текст = """" + СтрЗаменить(Текст, """", """""") + """";
	КонецЕсли;

	Возврат Текст;

КонецФункции

// Ограничивает длину текста.
//
// Параметры:
//  Текст - Строка - исходный текст.
//  МаксДлина - Число - максимальная длина.
//
// Возвращаемое значение:
//  Строка - текст не длиннее МаксДлина плюс многоточие.
//
Функция ОграничитьТекст(Текст, МаксДлина)

	Если СтрДлина(Текст) <= МаксДлина Тогда
		Возврат Текст;
	КонецЕсли;

	Возврат Лев(Текст, МаксДлина) + "...";

КонецФункции

