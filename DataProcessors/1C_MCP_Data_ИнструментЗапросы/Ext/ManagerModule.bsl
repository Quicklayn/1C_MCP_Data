// Регистрирует инструмент execute_query.
//
// Параметры:
//  Инструменты - ТаблицаЗначений - таблица инструментов сервера MCP.
//
Процедура ДобавитьИнструментExecuteQuery(Инструменты)

	МассивПараметров = Новый Массив;

	МассивПараметров.Добавить(ОписаниеПараметра(
		"querytext",
		"string",
		"Текст запроса на языке запросов 1С к текущей информационной базе. Допускается пакет запросов, разделённых символом "";"".",
		,
		Истина
	));

	МассивПараметров.Добавить(ОписаниеПараметра(
		"parameters",
		"object",
		"Параметры запроса: объект, где ключ — имя параметра без ""&"". Значения: строка, число, булево, null, массив или типизированный объект {""type"":""date"",""value"":""2026-01-01T00:00:00""} либо {""type"":""ref"",""value"":""Справочник.Номенклатура:<uuid>""}."
	));

	МассивПараметров.Добавить(ОписаниеПараметра(
		"format",
		"string",
		"Формат результата: table — текстовая таблица, csv — значения через запятую, json — массив результатов с колонками и строками. По умолчанию table.",
		"table",
		Ложь,
		"table,csv,json"
	));

	МассивПараметров.Добавить(ОписаниеПараметра(
		"maxRows",
		"number",
		"Максимум строк на один результат запроса. По умолчанию 1000; 0 — без ограничения; не более 100000.",
		1000
	));

	СтрокаИнструмента = Инструменты.Добавить();
	СтрокаИнструмента.Имя = "execute_query";
	СтрокаИнструмента.Описание = "Выполняет запрос на языке запросов 1С и возвращает результат в формате table, csv или json. Параметр parameters задаёт параметры запроса; поддерживаются строки, числа, булевы, null, массивы и типизированные значения date/ref. maxRows ограничивает число строк (по умолчанию 1000, 0 — без ограничения).";
	СтрокаИнструмента.СхемаПараметров = СхемаПараметровИнструмента(МассивПараметров);

КонецПроцедуры

