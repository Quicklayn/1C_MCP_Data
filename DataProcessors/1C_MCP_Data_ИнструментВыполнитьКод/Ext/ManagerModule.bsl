// Инструмент MCP: выполнение кода на встроенном языке 1С.
//
// Инструмент предназначен для проверки гипотез на тестовой базе: вычисления,
// запросы, обращения к объектам. Выполнение идёт в безопасном режиме,
// каждый вызов фиксируется в журнале регистрации.
//
// Внимание: инструмент выполняет произвольный код. Выдавайте роль
// "1C_MCP_Data_ПраваИнструментВыполнитьКод" только на тестовой базе.
//
// Метод "Выполнить" запрещён стандартами разработки, но здесь он является
// сутью инструмента: без него невозможно выполнить переданный фрагмент кода.

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Добавляет инструменты обработки-контейнера в таблицу инструментов сервера MCP.
//
// Общие модули расширения MCP_Сервер недоступны из этого расширения, поэтому
// строка инструмента и JSON-схема параметров строятся локально по контракту
// mcp_Метаданные.ДобавитьИнструмент и mcp_Метаданные.СхемаПараметровИнструмента.
//
// Параметры:
//  Инструменты - ТаблицаЗначений - таблица инструментов сервера MCP с колонками
//                ИмяОбработкиКонтейнера, Имя, Описание, СхемаПараметров.
//
Процедура ДобавитьИнструменты(Инструменты) Экспорт

	МассивПараметров = Новый Массив;

	МассивПараметров.Добавить(ОписаниеПараметра(
		"code",
		"string",
		"Фрагмент кода на встроенном языке 1С. Результат выполнения — значение переменной ""Результат"", которую код должен заполнить. Оператор ""Возврат"" на верхнем уровне не используется.",
		,
		Истина
	));

	МассивПараметров.Добавить(ОписаниеПараметра(
		"comment",
		"string",
		"Метка вызова для журнала аудита."
	));

	МассивПараметров.Добавить(ОписаниеПараметра(
		"maxResultChars",
		"number",
		"Максимальная длина текстового результата. По умолчанию 4000, не более 20000.",
		4000
	));

	СтрокаИнструмента = Инструменты.Добавить();
	СтрокаИнструмента.Имя = "execute_code";
	СтрокаИнструмента.Описание = "Выполняет фрагмент кода на встроенном языке 1С в безопасном режиме и возвращает значение переменной ""Результат"", которую заполняет код. Предназначен для проверки гипотез на тестовой базе; вызовы записываются в журнал регистрации.";
	СтрокаИнструмента.СхемаПараметров = СхемаПараметровИнструмента(МассивПараметров);

КонецПроцедуры

// Выполняет инструмент сервера MCP по имени.
//
// Параметры:
//  ИмяИнструмента - Строка - имя инструмента, объявленного в ДобавитьИнструменты.
//  Аргументы - Структура - аргументы вызова инструмента.
//
// Возвращаемое значение:
//  Строка - текстовый результат выполнения инструмента.
//
Функция ВыполнитьИнструмент(ИмяИнструмента, Аргументы) Экспорт

	Если ИмяИнструмента = "execute_code" Тогда
		Возврат ВыполнитьКод(Аргументы);
	КонецЕсли;

	ВызватьИсключение "Неизвестный инструмент: " + ИмяИнструмента;

КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выполняет переданный код и возвращает значение переменной "Результат" или текст ошибки.
//
// Параметры:
//  Аргументы - Структура - аргументы вызова инструмента, см. ДобавитьИнструменты.
//
// Возвращаемое значение:
//  Строка - "Результат: ..." или "Ошибка: ...".
//
Функция ВыполнитьКод(Аргументы)

	Код = "";
	Если Аргументы.Свойство("code") Тогда
		Код = СокрЛП(Строка(Аргументы.code));
	КонецЕсли;

	Если ПустаяСтрока(Код) Тогда
		ВызватьИсключение "Параметр code обязателен.";
	КонецЕсли;

	Если СтрДлина(Код) > 20000 Тогда
		ВызватьИсключение "Код длиннее 20000 символов.";
	КонецЕсли;

	МаксСимволов = МаксСимволовРезультата(Аргументы);
	Комментарий = КомментарийВызова(Аргументы);
	НачалоВыполнения = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Результат = Неопределено;
	ТекстОшибки = "";

	// Безопасный режим запрещает COM, внешние компоненты, файлы и интернет.
	// Он не является песочницей: код может читать и изменять данные базы.
	// Счётчик безопасного режима платформа восстанавливает при возврате из метода.
	УстановитьБезопасныйРежим(Истина);
	Попытка
		Выполнить(Код);
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;

	Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоВыполнения;
	Успешно = ПустаяСтрока(ТекстОшибки);
	ЗаписатьАудит(Комментарий, Код, Длительность, Успешно);

	Если Не Успешно Тогда
		Возврат "Ошибка: " + ТекстОшибки;
	КонецЕсли;

	Возврат "Результат: " + ОграничитьТекст(ЗначениеВТекст(Результат), МаксСимволов);

КонецФункции

// Возвращает максимальную длину результата из аргументов.
//
// Параметры:
//  Аргументы - Структура - аргументы вызова инструмента.
//
// Возвращаемое значение:
//  Число - длина от 100 до 20000 символов.
//
Функция МаксСимволовРезультата(Аргументы)

	Значение = 4000;
	Если Аргументы.Свойство("maxResultChars") Тогда
		Попытка
			Значение = Число(Аргументы.maxResultChars);
		Исключение
			Значение = 4000;
		КонецПопытки;
	КонецЕсли;

	Если Значение < 100 Тогда
		Возврат 100;
	ИначеЕсли Значение > 20000 Тогда
		Возврат 20000;
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Возвращает комментарий вызова для журнала аудита.
//
// Параметры:
//  Аргументы - Структура - аргументы вызова инструмента.
//
// Возвращаемое значение:
//  Строка - комментарий не длиннее 200 символов.
//
Функция КомментарийВызова(Аргументы)

	Если Аргументы.Свойство("comment") Тогда
		Возврат ОграничитьТекст(СокрЛП(Строка(Аргументы.comment)), 200);
	КонецЕсли;

	Возврат "";

КонецФункции

// Записывает сведения о вызове в журнал регистрации.
//
// Параметры:
//  Комментарий - Строка - метка вызова.
//  Код - Строка - текст выполненного кода.
//  Длительность - Число - длительность выполнения в миллисекундах.
//  Успешно - Булево - Истина, если код выполнен без ошибки.
//
Процедура ЗаписатьАудит(Комментарий, Код, Длительность, Успешно)

	Части = Новый Массив;
	Части.Добавить("execute_code");
	Части.Добавить("пользователь=" + ИмяПользователя());

	Если Не ПустаяСтрока(Комментарий) Тогда
		Части.Добавить("комментарий=" + Комментарий);
	КонецЕсли;

	Части.Добавить("длинаКода=" + СтрДлина(Код));
	Части.Добавить("мс=" + Длительность);

	Если Успешно Тогда
		Части.Добавить("результат=успех");
	Иначе
		Части.Добавить("результат=ошибка");
	КонецЕсли;

	ЗаписьЖурналаРегистрации("1C MCP.Выполнение кода", УровеньЖурналаРегистрации.Информация, , , СтрСоединить(Части, "; "));

КонецПроцедуры

// Преобразует значение произвольного типа в текст.
//
// Параметры:
//  Значение - Произвольный - значение результата.
//
// Возвращаемое значение:
//  Строка - текстовое представление значения.
//
Функция ЗначениеВТекст(Значение)

	Если Значение = Неопределено Тогда
		Возврат "Неопределено";
	КонецЕсли;

	Если Значение = Null Тогда
		Возврат "NULL";
	КонецЕсли;

	ТипЗначения = ТипЗнч(Значение);

	Если ТипЗначения = Тип("Строка") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Возврат Формат(Значение, "ДФ='yyyy-MM-dd HH:mm:ss'");
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		Если Значение Тогда
			Возврат "Истина";
		КонецЕсли;
		Возврат "Ложь";
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		Возврат Строка(Значение);
	ИначеЕсли ТипЗначения = Тип("Массив") Тогда
		Возврат МассивВТекст(Значение);
	ИначеЕсли ТипЗначения = Тип("Структура") Или ТипЗначения = Тип("Соответствие") Тогда
		Возврат КоллекцияВТекст(Значение);
	ИначеЕсли ТипЗначения = Тип("ТаблицаЗначений") Тогда
		Возврат ТаблицаВТекст(Значение);
	КонецЕсли;

	Возврат Строка(Значение);

КонецФункции

// Преобразует массив в текст.
//
// Параметры:
//  Массив - Массив - значение результата.
//
// Возвращаемое значение:
//  Строка - элементы в квадратных скобках.
//
Функция МассивВТекст(Массив)

	Части = Новый Массив;
	Для Каждого Элемент Из Массив Цикл
		Части.Добавить(ЗначениеВТекст(Элемент));
	КонецЦикла;

	Возврат "[" + СтрСоединить(Части, ", ") + "]";

КонецФункции

// Преобразует структуру или соответствие в текст.
//
// Параметры:
//  Коллекция - Структура, Соответствие - значение результата.
//
// Возвращаемое значение:
//  Строка - пары "ключ = значение" построчно.
//
Функция КоллекцияВТекст(Коллекция)

	Части = Новый Массив;
	Для Каждого Элемент Из Коллекция Цикл
		Части.Добавить(Строка(Элемент.Ключ) + " = " + ЗначениеВТекст(Элемент.Значение));
	КонецЦикла;

	Возврат "{" + Символы.ПС + СтрСоединить(Части, Символы.ПС) + Символы.ПС + "}";

КонецФункции

// Преобразует таблицу значений в текст.
//
// Параметры:
//  Таблица - ТаблицаЗначений - значение результата.
//
// Возвращаемое значение:
//  Строка - заголовок и строки таблицы.
//
Функция ТаблицаВТекст(Таблица)

	Если Таблица.Колонки.Количество() = 0 Тогда
		Возврат "ТаблицаЗначений: 0 колонок";
	КонецЕсли;

	Строки = Новый Массив;
	Заголовки = Новый Массив;
	Для Каждого Колонка Из Таблица.Колонки Цикл
		Заголовки.Добавить(Колонка.Имя);
	КонецЦикла;
	Строки.Добавить(СтрСоединить(Заголовки, " | "));

	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Значения = Новый Массив;
		Для Каждого Колонка Из Таблица.Колонки Цикл
			Значения.Добавить(ЗначениеВТекст(СтрокаТаблицы[Колонка.Имя]));
		КонецЦикла;
		Строки.Добавить(СтрСоединить(Значения, " | "));
	КонецЦикла;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Ограничивает текст заданной длиной.
//
// Параметры:
//  Текст - Строка - исходный текст.
//  МаксДлина - Число - максимальная длина.
//
// Возвращаемое значение:
//  Строка - текст не длиннее МаксДлина.
//
Функция ОграничитьТекст(Текст, МаксДлина)

	Если СтрДлина(Текст) <= МаксДлина Тогда
		Возврат Текст;
	КонецЕсли;

	Возврат Лев(Текст, МаксДлина) + "... (обрезано)";

КонецФункции

// Создаёт описание простого параметра инструмента для построения JSON-схемы.
//
// Параметры:
//  Имя - Строка - имя параметра.
//  Тип - Строка - тип параметра в терминах JSON Schema, например "string".
//  Описание - Строка - описание параметра для ассистента.
//  ЗначениеПоУмолчанию - Произвольный - значение по умолчанию; Неопределено — не задано.
//  Обязательный - Булево - Истина, если параметр обязателен.
//  ДопустимыеЗначения - Строка - допустимые значения через запятую.
//
// Возвращаемое значение:
//  Структура - описание параметра инструмента.
//
Функция ОписаниеПараметра(Имя, Тип, Описание, ЗначениеПоУмолчанию = Неопределено, Обязательный = Ложь, ДопустимыеЗначения = "")

	Параметр = Новый Структура;
	Параметр.Вставить("Имя", Имя);
	Параметр.Вставить("Вид", "Простой");
	Параметр.Вставить("Тип", Тип);
	Параметр.Вставить("Описание", Описание);
	Параметр.Вставить("ЗначениеПоУмолчанию", ЗначениеПоУмолчанию);
	Параметр.Вставить("Обязательный", Обязательный);
	Параметр.Вставить("ДопустимыеЗначения", ДопустимыеЗначения);

	Возврат Параметр;

КонецФункции

// Формирует JSON-схему параметров инструмента.
//
// Параметры:
//  ОписанияПараметров - Массив из Структура - описания параметров,
//                       см. ОписаниеПараметра.
//
// Возвращаемое значение:
//  Строка - JSON-схема параметров инструмента.
//
Функция СхемаПараметровИнструмента(ОписанияПараметров)

	Свойства = Новый Структура;
	ОбязательныеПараметры = Новый Массив;

	Для Каждого Описание Из ОписанияПараметров Цикл
		СвойствоПараметра = Новый Структура;
		СвойствоПараметра.Вставить("type", Описание.Тип);
		СвойствоПараметра.Вставить("description", Описание.Описание);

		Если Описание.ЗначениеПоУмолчанию <> Неопределено Тогда
			СвойствоПараметра.Вставить("default", Описание.ЗначениеПоУмолчанию);
		КонецЕсли;

		Если Не ПустаяСтрока(Описание.ДопустимыеЗначения) Тогда
			СвойствоПараметра.Вставить("enum", МассивДопустимыхЗначений(Описание.ДопустимыеЗначения));
		КонецЕсли;

		Свойства.Вставить(Описание.Имя, СвойствоПараметра);

		Если Описание.Обязательный Тогда
			ОбязательныеПараметры.Добавить(Описание.Имя);
		КонецЕсли;
	КонецЦикла;

	Схема = Новый Структура;
	Схема.Вставить("type", "object");
	Схема.Вставить("properties", Свойства);
	Схема.Вставить("required", ОбязательныеПараметры);

	Возврат СхемаВJSON(Схема);

КонецФункции

// Преобразует строку со списком допустимых значений в массив.
//
// Параметры:
//  СписокЗначений - Строка - значения через запятую.
//
// Возвращаемое значение:
//  Массив из Строка - допустимые значения без пробелов по краям.
//
Функция МассивДопустимыхЗначений(СписокЗначений)

	МассивЗначений = Новый Массив;
	Для Каждого Значение Из СтрРазделить(СписокЗначений, ",", Ложь) Цикл
		МассивЗначений.Добавить(СокрЛП(Значение));
	КонецЦикла;

	Возврат МассивЗначений;

КонецФункции

// Сериализует схему параметров инструмента в строку JSON.
//
// Параметры:
//  Схема - Структура - схема параметров инструмента.
//
// Возвращаемое значение:
//  Строка - JSON-представление схемы.
//
Функция СхемаВJSON(Схема)

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Схема);

	Возврат ЗаписьJSON.Закрыть();

КонецФункции

#КонецОбласти

#КонецЕсли
